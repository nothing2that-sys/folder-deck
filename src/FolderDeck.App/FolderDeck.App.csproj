<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FolderDeck.Core\FolderDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- FpuGuard(F-1)는 Interop/ 의 관례대로 internal 이다. 시험이 그 스코프를 열고 닫아
       봐야 하므로 시험 어셈블리에만 internal 을 연다 — 타입을 public 으로 올리지 않는다. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FolderDeck.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderDeck</AssemblyName>
    <RootNamespace>FolderDeck.App</RootNamespace>
    <ApplicationIcon>Assets\FolderDeck.ico</ApplicationIcon>

    <!-- 설치 배포용 파일 속성 (Phase 7 · D46). exe 속성 창과 작업 관리자에 그대로 나온다. -->
    <Company>JH</Company>
    <Product>Folder Deck</Product>
    <Version>1.0.0</Version>

    <!-- DPI 인식을 프로세스 시작 시점에 확정한다 (§6.1 · Stage 2 §3.1). 이유는 파일 안 주석. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
