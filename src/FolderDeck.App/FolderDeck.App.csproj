<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FolderDeck.Core\FolderDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 내용 비교(기능 후보 ①의 연장, 2026-09-18)가 CP949(한국어 레거시 텍스트) 코드페이지를
         읽으려면 필요하다 — .NET Core 는 기본으로 UTF 계열만 안다. FileContentReader 가
         정적 생성자에서 등록한다. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>

  <!-- FpuGuard(F-1)는 Interop/ 의 관례대로 internal 이다. 시험이 그 스코프를 열고 닫아
       봐야 하므로 시험 어셈블리에만 internal 을 연다 — 타입을 public 으로 올리지 않는다. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FolderDeck.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Everything64.dll 배관(D65). voidtools Everything SDK — 라이선스는 같은 폴더의
       THIRD-PARTY-NOTICES.txt. SDK 폴더(Everything-SDK/) 는 참조하지 않는다(결정 2) —
       이 복사본만 쓴다. 빌드 출력과 게시 출력 둘 다에 들어가야 감지·배포가 된다. -->
  <ItemGroup>
    <!-- Link 로 평탄화한다 — 표준 DLL 검색 순서는 실행 파일과 같은 폴더만 보고 하위 폴더는
         안 본다(D64 Q2 실측). Native\ 아래 그대로 두면 배포본에서 못 찾는다. -->
    <None Include="Native\Everything64.dll" Link="Everything64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderDeck</AssemblyName>
    <RootNamespace>FolderDeck.App</RootNamespace>
    <ApplicationIcon>Assets\FolderDeck.ico</ApplicationIcon>

    <!-- 설치 배포용 파일 속성 (Phase 7 · D46). exe 속성 창과 작업 관리자에 그대로 나온다. -->
    <Company>JH</Company>
    <Product>Folder Deck</Product>
    <!-- Version 은 저장소 루트 Directory.Build.props 한 자리에 있다 (D82). -->

    <!-- DPI 인식을 프로세스 시작 시점에 확정한다 (§6.1 · Stage 2 §3.1). 이유는 파일 안 주석. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- NU1510 은 System.Text.Encoding.CodePages 가 "안 써도 될 것 같다"고 하지만 틀렸다 —
         CodePagesEncodingProvider 타입 자체가 이 패키지에만 있고(내용 비교의 CP949 폴백,
         FileContentReader), 셰어드 프레임워크에 포함돼 있지 않다. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

</Project>
