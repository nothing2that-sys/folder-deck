<Window x:Class="FolderDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FolderDeck.App.Views"
        xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
        xmlns:layout="clr-namespace:FolderDeck.Core.Layout;assembly=FolderDeck.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title, StringFormat=FolderDeck — {0}}"
        Height="900" Width="1400"
        MinWidth="{x:Static layout:WindowPlacement.MinWindowWidth}"
        MinHeight="{x:Static layout:WindowPlacement.MinWindowHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!-- 갱신 자리 넷 중 하나 — 수동(F5). 나머지는 창 활성화 · 조작 후 · 타일마다 붙는
         FileSystemWatcher(§8) 다. 감시자가 붙었다고 이 셋을 지우지 않는다: 감시가
         죽어도(연결 상실 거동은 미확인) 목록이 영영 낡지 않게 남겨 둔 안전망이다. -->

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
        <!-- Del = 휴지통 (§4.4). 검색창처럼 Delete 를 스스로 처리하는 컨트롤 안에서는
             이벤트가 여기까지 올라오지 않으므로 글자 지우기를 뺏지 않는다.
             Shift+Del(영구 삭제)은 탐색기와 달리 막는다 — 수정키가 정확히 맞아야
             걸리므로 두 바인딩이 서로를 가리지 않는다. -->
        <KeyBinding Key="Delete" Command="{Binding TrashSelectionCommand}" />
        <KeyBinding Modifiers="Shift" Key="Delete" Command="{Binding RejectPermanentDeleteCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ── 상단 툴바: 배치 편집 토글 (Phase 2) ──
                 평소(뷰 모드)엔 타일이 잠겨 파일 작업 중에 배치가 흔들리지 않는다. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Brush.Border}"
                Background="{StaticResource Brush.Chrome}" Padding="8,5">
            <DockPanel>
                <!-- 왼쪽 패널 통째 접기 (Phase 8-A ⑦). 패널 안 두 헤더의 접기와 별개다 —
                     이쪽은 컬럼 자체를 없애 그리드가 창을 다 쓰게 한다. -->
                <Button DockPanel.Dock="Left" Style="{StaticResource NavButton}"
                        Margin="0,0,6,0"
                        Command="{Binding ToggleLeftPanelCommand}"
                        Content="{Binding LeftPanelToggleText}"
                        ToolTip="{Binding LeftPanelToggleTip}"
                        AutomationProperties.Name="왼쪽 패널 접기/펴기" />

                <Button DockPanel.Dock="Left" Style="{StaticResource EditModeButton}"
                        Command="{Binding ToggleLayoutEditCommand}"
                        Content="{Binding EditToggleText}"
                        AutomationProperties.Name="배치 편집"
                        ToolTip="켜면 타일을 옮기고 크기를 바꿀 수 있다. 그동안 파일 목록은 잠긴다." />

                <!-- 실행하면 선택 창이 뜨지만 고르는 순간 그 창이 워크스페이스 창이 되므로,
                     다른 작업 관리로 가는 길이 여기 하나 있어야 한다 (§5 · Phase 6). -->
                <Button DockPanel.Dock="Left" Padding="12,4" Margin="6,0,0,0"
                        Command="{Binding OpenLauncherCommand}"
                        Content="다른 작업 관리 열기"
                        AutomationProperties.Name="다른 작업 관리 열기"
                        ToolTip="작업 관리 목록을 새 창으로 띄운다 — 거기서 다른 작업 관리를 열 수 있다. 이 창은 그대로 남는다." />

                <!-- 휴지통은 목적지가 없으므로 대상함 탭이 아니라 여기다 (§4.4).
                     확인창은 두지 않는다 — 되돌릴 수 있는 동작이고, 몇 개를 보냈는지 알린다. -->
                <Button DockPanel.Dock="Right" Padding="12,4"
                        Command="{Binding TrashSelectionCommand}"
                        Content="휴지통으로 삭제"
                        AutomationProperties.Name="휴지통으로 삭제"
                        ToolTip="고른 것을 휴지통으로 보낸다 (Del) — 영구 삭제가 아니라 되돌릴 수 있다. 폴더는 통째로 간다." />

                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.EditChromeText}"
                           Visibility="{Binding IsEditingLayout, Converter={StaticResource BoolToVisibility}}"
                           Text="배치 편집 중 — 타일 끌어 이동 · 오른쪽 아래 ◢ 로 크기 · 우클릭으로 상시↔순환/제거 · 빈 칸 클릭이나 폴더 끌어놓기로 추가" />
            </DockPanel>
        </Border>

        <!-- ── 하단 상태 바: 순환 칸의 전체 경로 (§3.2) ── -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                Background="{StaticResource Brush.Chrome}" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusLabel}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Margin="0,0,6,0" />
                <!-- 실패·거절은 빨강, 정보성 안내는 보조색. 안내는 잠깐 뒤 스스로 사라진다
                     (타이머는 코드 비하인드) — 실패 요약은 남는다. -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding Message}" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusPath}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusPath}" />
            </DockPanel>
        </Border>

        <!-- ── 진행 줄 (§1.1 — 폴더 재귀·볼륨 간 이동은 오래 걸린다) ──
                 상태 바 바로 위에 붙는다(DockPanel 은 먼저 붙은 쪽이 바깥이라 순서가 이 뜻이다).
                 짧은 조작에는 뜨지 않는다 — 뷰모델이 0.4초 뒤에도 돌고 있을 때만 켠다. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border}"
                Background="{StaticResource Brush.Chrome}" Padding="10,5"
                Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="취소" Padding="14,3" Margin="10,0,0,0"
                        Command="{Binding CancelOperationCommand}"
                        AutomationProperties.Name="조작 취소"
                        ToolTip="지금 처리 중인 파일까지만 하고 멈춘다. 이동은 원본을 지우기 전이라 그대로 남는다." />
                <ProgressBar DockPanel.Dock="Left" Width="180" Height="12" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}"
                             Foreground="{StaticResource Brush.Accent}"
                             Background="{StaticResource Brush.GridCellSurface}"
                             BorderBrush="{StaticResource Brush.Border}" />
                <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 좌우 둘 다 비율(star)이다. 왼쪽을 고정 px 로 두면 창을 줄일 때 그 변화를
                     오른쪽 그리드가 전부 떠안아 타일만 쪼그라든다. 비율로 두면 같이 줄고,
                     스플리터로 비율을 바꾸면 그 비율이 이후 크기 변화에도 유지된다.
                     MaxWidth 는 넓은 모니터에서 폴더 리스트가 한없이 넓어지는 것만 막는
                     안전선이다 — 낮게 잡으면 그 폭부터는 다시 오른쪽만 변해서 고정 px 과
                     같아지므로, 손으로 넓히는 데 걸리지 않을 만큼 넉넉히 둔다. -->
                <!-- 접을 때 폭을 0 으로 만드는 것은 코드 비하인드다(ApplyLeftPanelWidth) —
                     행 높이와 같은 이유로 바인딩을 쓰지 않는다. GridSplitter 가 로컬 값을
                     써 버려 바인딩이 지워지기 때문이다(아래 ApplyLeftRowHeights 주석). -->
                <ColumnDefinition x:Name="LeftColumn" Width="1*" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="6" />
                <ColumnDefinition Width="3*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ══ 왼쪽 컬럼 — 상하 2분할 ══ -->
            <Grid Grid.Column="0"
                  Visibility="{Binding LeftPanelCollapsed,
                               Converter={StaticResource InverseBoolToVisibility}}">
                <!-- 접으면 본문만 숨기는 게 아니라 행 높이도 Auto 로 줄인다 — 안 그러면
                     접힌 영역이 빈 공간을 계속 차지한다. 접힘은 워크스페이스에 저장된다.
                     높이는 코드 비하인드가 정한다(ApplyLeftRowHeights). 바인딩으로 두면
                     GridSplitter 를 한 번만 끌어도 그 바인딩이 로컬 값에 덮여 사라지고,
                     그 뒤로는 접어도 행 높이가 안 줄어 빈 자리가 남는다. -->
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FoldersRow" MinHeight="0" Height="2*" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="LowerRow" MinHeight="0" Height="1*" />
                </Grid.RowDefinitions>

                <!-- 위: 폴더 리스트 = 유일한 컨트롤러 (§3.2) -->
                <DockPanel Grid.Row="0">
                    <!-- Terminal Deck 목록 헤더와 같은 결: 제목/접기와 새 항목 추가를 한 줄에 둔다. -->
                    <DockPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                                Content="＋"
                                Click="OnAddFoldersClick"
                                ToolTip="폴더를 선택해 이 작업 관리에 등록"
                                AutomationProperties.Name="폴더 추가" />

                        <!-- 헤더 클릭 = 접기/펴기. 자동으로 접히지 않는다. -->
                        <Button Style="{StaticResource FolderRowButton}"
                                Command="{Binding ToggleFoldersCommand}"
                                ToolTip="폴더 리스트 접기/펴기"
                                AutomationProperties.Name="폴더 리스트 접기/펴기">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"
                                           Foreground="{StaticResource Brush.TextSecondary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▾" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FoldersCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="▸" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="폴더" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Margin="10,4,10,6" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"
                               Text="클릭 = 순환 칸에 표시 · 재클릭 = 앵커로 복귀 · 우클릭 = 순환 번호 지정&#x0a;그리드 파일을 이 행으로 끌면 이동 (Ctrl 을 누르면 복사)&#x0a;배치 편집 중에는 빈 칸으로 끌어다 놓을 수 있다"
                               Visibility="{Binding FoldersCollapsed,
                                            Converter={StaticResource InverseBoolToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0"
                                  Visibility="{Binding FoldersCollapsed,
                                               Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                                    <!-- 우클릭 = 순환 번호 지정. 배치 편집 중에는 빈 칸으로 끌어다 놓을 수 있다. -->
                                    <Button Style="{StaticResource FolderListRowButton}"
                                            Command="{Binding DataContext.ShowFolderCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            PreviewMouseLeftButtonDown="OnFolderRowMouseDown"
                                            PreviewMouseMove="OnFolderRowMouseMove"
                                            AllowDrop="True"
                                            DragEnter="OnFileDropOver"
                                            DragOver="OnFileDropOver"
                                            DragLeave="OnFileDropLeave"
                                            Drop="OnFileDrop"
                                            ToolTip="{Binding PathText}"
                                            Tag="{Binding DataContext,
                                                  RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <!-- 대상함 출처: 왼쪽 리스트가 진입점이다
                                                     (임의 경로 직접 추가는 후순위, §11). -->
                                                <MenuItem Header="대상함에 추가"
                                                          Command="{Binding PlacementTarget.Tag.AddToTrayCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <!-- 상시 칸에 못박힌 폴더는 순환 칸으로 가지 않는다.
                                                     메뉴를 없애 버리면 왜 없는지 알 수 없으니,
                                                     비활성으로 두고 이유를 헤더에 적는다. -->
                                                <MenuItem ItemsSource="{Binding RotationChoices}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="순환 칸 지정" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasPinnedTile}"
                                                                             Value="True">
                                                                    <Setter Property="Header"
                                                                            Value="순환 칸 지정 — 상시 칸이라 해당 없음" />
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Label}" />
                                                            <Setter Property="InputGestureText"
                                                                    Value="{Binding Note}" />
                                                            <Setter Property="IsCheckable" Value="True" />
                                                            <Setter Property="IsChecked"
                                                                    Value="{Binding IsSelected, Mode=OneWay}" />
                                                            <Setter Property="Command"
                                                                    Value="{Binding SelectCommand}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                                <Separator />
                                                <!-- 폴더 등록 자체를 고치고 지운다 (§4.11-2·3).
                                                     위의 둘은 이 폴더를 "어디에 쓸지"를 정하고,
                                                     아래 둘은 등록 자체를 건드린다. -->
                                                <MenuItem Header="수정"
                                                          Command="{Binding PlacementTarget.Tag.EditFolderCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}" />
                                                <MenuItem Header="제거"
                                                          Command="{Binding PlacementTarget.Tag.RemoveFolderCommand,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                    RelativeSource={RelativeSource
                                                                        AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- pin 글리프: 상시 = 채운 실선, 순환 전용 = 점선 (§3.2) -->
                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                     StrokeThickness="2" VerticalAlignment="Top"
                                                     Margin="0,4,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Stroke"
                                                                Value="{StaticResource Brush.Rotating}" />
                                                        <Setter Property="StrokeDashArray" Value="1.6 1.4" />
                                                        <Setter Property="Fill" Value="Transparent" />
                                                        <Setter Property="ToolTip" Value="순환 전용" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Stroke"
                                                                        Value="{StaticResource Brush.Pinned}" />
                                                                <Setter Property="StrokeDashArray"
                                                                        Value="{x:Null}" />
                                                                <Setter Property="Fill"
                                                                        Value="{StaticResource Brush.Pinned}" />
                                                                <Setter Property="ToolTip" Value="상시 표시" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- 접근 불가 — 목록에서 지우지 않는다 (§5) -->
                                                    <Border Background="{StaticResource Brush.DangerSurface}" CornerRadius="2"
                                                            Padding="4,0" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsInaccessible,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="접근 불가" FontSize="10"
                                                                   Foreground="{StaticResource Brush.Danger}" />
                                                    </Border>

                                                    <!-- 드롭 과녁 — 끌어온 파일이 이 행 위에 있다 (§4.2-2).
                                                         테두리만으로는 좁은 행에서 눈에 안 띄어 말로도 적는다.
                                                         IsHitTestVisible="False" — 이것이 없으면 커서가 이 글귀
                                                         위로 올라갔을 때 강조가 진동한다(자세한 이유는
                                                         FolderPanelView.xaml 의 같은 자리 주석). -->
                                                    <Border Background="{StaticResource Brush.AccentSurface}"
                                                            CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding IsDropTarget,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="여기에 놓기" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Accent}" />
                                                    </Border>

                                                    <!-- 순환 번호 태그. 순환 칸이 하나뿐이면 소음이라 숨긴다. -->
                                                    <Border Background="{StaticResource Brush.RotatingSurface}"
                                                            CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="이 폴더를 클릭하면 뜨는 순환 칸 (우클릭으로 바꾼다)"
                                                            Visibility="{Binding ShowRotationTag,
                                                                Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding RotationSlotText}" FontSize="10"
                                                                   Foreground="{StaticResource Brush.Rotating}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding PathText}" FontSize="10"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasDescription,
                                                               Converter={StaticResource BoolToVisibility}}" />

                                                <!-- 앵커를 벗어난 상태: "지금 src › Recipe 안" (§3.2) -->
                                                <TextBlock Text="{Binding LocationHint}" FontSize="11"
                                                           Foreground="{StaticResource Brush.Rotating}"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding HasLocationHint,
                                                               Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <!-- 목록에서 바로 제거한다. 실제 폴더 삭제가 아니라 등록 제거이며,
                                                 기존 RemoveFolderCommand 의 확인창을 그대로 쓴다 (D38).
                                                 행 버튼 안에 겹쳐 둔다 — 칸을 갈라 내주면 그 폭만큼
                                                 우클릭·파일 드롭·배치 편집 드래그가 죽는다. -->
                                            <Button Grid.Column="1" Style="{StaticResource RowActionButton}"
                                                    Content="✕"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,1,0,0"
                                                    Command="{Binding DataContext.RemoveFolderCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="작업 관리에서 등록만 지운다. 실제 폴더는 그대로다"
                                                    AutomationProperties.Name="폴더 등록 제거" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- ResizeBehavior 를 명시한다. 기본값(BasedOnAlignment)이면 스플리터가
                     자기 자신의 4px 칸을 늘리려 들어 아무 일도 일어나지 않는다. -->
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Style="{StaticResource RowSplitter}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Visibility="{Binding ShowLeftSplitter,
                                           Converter={StaticResource BoolToVisibility}}" />

                <!-- 아래: 대상함 / 매크로 탭 — Phase 1 은 자리만, 동작 없음 (§10.3).
                     접기 대상이 될 뿐 동작은 뒤 Phase 다. -->
                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Top" Style="{StaticResource FolderRowButton}"
                            Command="{Binding ToggleLowerCommand}"
                            ToolTip="대상함/매크로 영역 접기/펴기"
                            AutomationProperties.Name="대상함 매크로 접기/펴기"
                            Margin="6,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="{StaticResource Brush.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▾" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LowerCollapsed}" Value="True">
                                                <Setter Property="Text" Value="▸" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="대상함 · 매크로" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <TabControl Margin="6,0,6,6" BorderThickness="1" BorderBrush="{StaticResource Brush.Border}"
                                Visibility="{Binding LowerCollapsed,
                                             Converter={StaticResource InverseBoolToVisibility}}">
                        <TabItem Header="복사 대상함">
                            <!-- 체크된 폴더가 목적지다. 다중 체크 = 동시 복사 (§4.2-1). -->
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding OperationSummary}" FontSize="11"
                                               TextWrapping="Wrap" Margin="2,0,2,4"
                                               Foreground="{StaticResource Brush.TextSecondary}" />

                                    <!-- 동일 이름 충돌 (§4.3). 평소엔 "물어본다"고만 적혀 있고,
                                         "다음부터 묻지 않기"를 켠 뒤에는 무엇을 하는지와
                                         되돌릴 자리가 같이 보인다 — 잊고 조용히 덮어쓰지 않게. -->
                                    <StackPanel Orientation="Horizontal" Margin="2,0,2,6">
                                        <TextBlock Text="{Binding ConflictPolicyText}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                        <Button Style="{StaticResource LinkButton}"
                                                Content="다시 묻기" FontSize="11" Margin="4,0,0,0"
                                                Command="{Binding RestoreConflictPromptCommand}"
                                                ToolTip="같은 이름이 있을 때 다시 물어보게 되돌린다"
                                                Visibility="{Binding CanRestoreConflictPrompt,
                                                             Converter={StaticResource BoolToVisibility}}">
                                            <Button.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Accent}" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="복사" Padding="14,4" Margin="0,0,6,0"
                                                Command="{Binding CopySelectionCommand}"
                                                ToolTip="고른 파일을 체크된 폴더 전부에 복사한다" />
                                        <Button Content="이동" Padding="14,4"
                                                Command="{Binding MoveSelectionCommand}"
                                                ToolTip="고른 파일을 체크된 폴더로 옮긴다 — 원본이 사라지므로 확인을 받는다" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="왼쪽 폴더를 우클릭해 &#x27;대상함에 추가&#x27;.&#x0a;여기에 항목을 끌어다 놓으면 그 폴더 하나로만 간다."
                                           FontSize="11" TextWrapping="Wrap" Margin="2,4"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Visibility="{Binding TrayIsEmpty,
                                                        Converter={StaticResource BoolToVisibility}}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Tray}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TrayEntryViewModel}">
                                                <!-- 체크(=버튼 실행의 목적지)와 별개로, 여기로 직접
                                                     끌어다 놓을 수도 있다 (§4.2-2). -->
                                                <Border Margin="0,1" CornerRadius="3" Padding="2,1"
                                                        BorderThickness="1"
                                                        ToolTip="{Binding PathText}"
                                                        AllowDrop="True"
                                                        DragEnter="OnFileDropOver"
                                                        DragOver="OnFileDropOver"
                                                        DragLeave="OnFileDropLeave"
                                                        Drop="OnFileDrop">
                                                    <!-- 색은 스타일에서만 준다. 로컬 값을 주면
                                                         스타일 트리거를 영구히 이겨 과녁이 켜지지 않는다
                                                         (실제로 그랬다 — WPF 값 우선순위). -->
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDropTarget}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                        Value="{StaticResource Brush.AccentSurface}" />
                                                                    <Setter Property="BorderBrush"
                                                                        Value="{StaticResource Brush.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕"
                                                                Style="{StaticResource NavButton}"
                                                                Command="{Binding RemoveCommand}"
                                                                AutomationProperties.Name="대상함에서 빼기"
                                                                ToolTip="대상함에서 뺀다 (폴더는 그대로)" />
                                                        <CheckBox IsChecked="{Binding IsChecked}"
                                                                  VerticalContentAlignment="Center"
                                                                  Checked="OnTrayCheckChanged"
                                                                  Unchecked="OnTrayCheckChanged">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                        <!-- 저장된 규칙 카드 (§4.7). 대상함·드래그와 같은 엔진에 얹힌다. -->
                        <TabItem Header="매크로">
                            <DockPanel Margin="6">
                                <Button DockPanel.Dock="Bottom" Content="지금 설정으로 매크로 만들기"
                                        Padding="10,5" Margin="0,6,0,0"
                                        Command="{Binding CreateMacroCommand}"
                                        ToolTip="지금 고른 것과 대상함 체크 상태를 규칙으로 굳힌다" />

                                <TextBlock DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap"
                                           Margin="2,6,2,0"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Text="그리드에서 파일을 고른 뒤 만들면 지금 상태가 그대로 채워진다."
                                           Visibility="{Binding MacrosAreEmpty,
                                                        Converter={StaticResource BoolToVisibility}}" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Macros}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MacroCardViewModel}">
                                                <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="3"
                                                        BorderThickness="1"
                                                        BorderBrush="{StaticResource Brush.Border}"
                                                        Background="{StaticResource Brush.Surface}">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="✕"
                                                                Style="{StaticResource NavButton}"
                                                                VerticalAlignment="Top"
                                                                Command="{Binding DataContext.RemoveMacroCommand,
                                                                          RelativeSource={RelativeSource
                                                                              AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="매크로 지우기"
                                                                ToolTip="이 규칙을 지운다 (파일은 그대로)" />
                                                        <Button DockPanel.Dock="Right" Content="실행"
                                                                Padding="10,2" Margin="0,0,4,0"
                                                                VerticalAlignment="Top"
                                                                Command="{Binding DataContext.RunMacroCommand,
                                                                          RelativeSource={RelativeSource
                                                                              AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Summary}" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                                            <!-- 확인 없이 도는 규칙은 눌렀을 때 바로 실행된다.
                                                                 그 사실이 카드에 보여야 한다. -->
                                                            <TextBlock Text="확인 없이 바로 실행" FontSize="10"
                                                                       Foreground="{StaticResource Brush.Danger}"
                                                                       Visibility="{Binding RunsWithoutConfirm,
                                                                            Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>

            <!-- 좌우 비율을 손으로 조절한다. ResizeBehavior 를 명시하지 않으면(기본
                 BasedOnAlignment + 기본 HorizontalAlignment=Right) 양옆이 아니라 스플리터
                 자신의 칸을 대상으로 삼아 끌어도 꿈쩍하지 않는다. -->
            <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Style="{StaticResource ColumnSplitter}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding LeftPanelCollapsed,
                                       Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- ══ 오른쪽 컬럼 — 4x4 그리드 + 배치 편집 (§3.2 · Phase 2) ══ -->
            <views:TileGridView Grid.Column="2" Margin="2,4,6,4" />
        </Grid>
    </DockPanel>
</Window>
