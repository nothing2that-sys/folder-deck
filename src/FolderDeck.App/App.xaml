<Application x:Class="FolderDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FolderDeck.App.Converters">
    <!-- StartupUri 를 쓰지 않는다. 설정을 먼저 읽어 런처/메인 중 무엇을 띄울지 정한다(App.xaml.cs). -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- 색은 전부 여기서 온다. 나중에 이 딕셔너리 하나만 갈아끼우면 앱 전체가 다크가 된다. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:CollapsibleRowHeightConverter x:Key="RowHeight" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:WiderThanConverter x:Key="WiderThan" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            리스트 행처럼 보이는 넓적한 버튼. 폴더 행 말고 접기 헤더·팝업 항목도 이 모양을 쓴다.
            그래서 여기에는 <b>폴더 행에만 있는 속성에 대한 바인딩을 두지 않는다</b> —
            DataContext 가 행이 아닌 곳에서 매번 바인딩 오류가 난다(실제로 그랬다).
            행 전용 강조는 아래 FolderListRowButton 에 있다.
        -->
        <Style x:Key="FolderRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            왼쪽 폴더 리스트의 행 — 지금 순환 칸에 떠 있는 폴더를 강조한다.
            템플릿의 Back 은 TemplateBinding Background 를 쓰므로 여기서 Background 만 바꾸면 되고,
            마우스 오버는 템플릿 트리거라 그 위를 덮는다(손이 올라간 쪽이 이겨야 맞다).
        -->
        <Style x:Key="FolderListRowButton" TargetType="Button" BasedOn="{StaticResource FolderRowButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShowingInRotating}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.RowActive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            헤더 내비 클러스터의 아이콘 버튼 — ← → ↑ ⌂ ⟳ 🔍 가 같은 크기·모양으로 보여야
            "눌러진다"가 자명해진다.
        -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            좁은 타일에서 아이콘을 접는 두 단계.

            1x1 타일은 작은 창에서 100px 도 안 되는데 내비 아이콘 6개만 144px 다. 그대로 두면
            잘리고, 잘리지 않게 breadcrumb 을 밀어내면 이번엔 <b>폴더 이름</b>이 사라진다 —
            이름이 아이콘보다 중요하다. 그래서 대체 조작이 있는 것부터 순서대로 접는다.

            240px 아래: 뒤로 · 앞으로(마우스 XButton, Alt+←/→) · 다시 읽기(F5)
            170px 아래: 상위(Alt+↑) · 검색(Ctrl+F)
            끝까지 남는 것: 앵커 복귀(⌂) — breadcrumb 이 잘리면 첫 조각 클릭도 못 하므로
            집으로 돌아갈 길이 아예 없어진다.
        -->
        <Style x:Key="SecondaryNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="240" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TertiaryNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="170" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            🔍 — 열려 있는 동안 눌린 표시. ToggleButton 을 쓰지 않는 이유:
            클릭하면 WPF 가 IsChecked 에 "로컬 값"을 심는데, 그 로컬 값이 OneWay 바인딩을
            영구히 이겨버린다. 그러면 포커스가 빠져 검색줄이 접힌 뒤에도 버튼만 눌린 채로 남는다
            (실제로 그렇게 어긋나는 것을 확인했다). 상태는 뷰모델만 갖고, 여기서는 그리기만 한다.
        -->
        <Style x:Key="NavToggleButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchExpanded}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.RowActive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 검색 토글도 같은 단계에서 접힌다(모양만 NavToggleButton 을 따른다). -->
        <Style x:Key="TertiaryNavToggleButton" TargetType="Button"
               BasedOn="{StaticResource NavToggleButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="170" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            툴바의 "배치 편집" 토글 (Phase 2). NavToggleButton 과 같은 이유로 ToggleButton 을
            쓰지 않는다: 클릭하면 WPF 가 IsChecked 에 로컬 값을 심고, 그 값이 OneWay 바인딩을
            영구히 이겨 버려 뷰모델 상태와 버튼 모양이 어긋난다. 상태는 뷰모델만 갖는다.
        -->
        <Style x:Key="EditModeButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="3" BorderThickness="1"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <!-- 편집 중임이 버튼에서도 바로 보이게 — 눌린 모양으로 남는다. -->
                            <DataTrigger Binding="{Binding IsEditingLayout}" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.EditChrome}" />
                                <Setter TargetName="Back" Property="BorderBrush"
                                        Value="{StaticResource Brush.DropValid}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Brush.EditChromeText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            스플리터 — 잡을 수 있는 자리임이 보여야 한다. 선은 1px 만 긋고 잡히는 띠는 6px 다
            (보이는 것보다 잡기 쉽게). 손을 올리면 선이 굵고 파래져 "여기서 끌린다"가 드러나고,
            끄는 동안에도 그 상태를 유지한다. GridSplitter 는 Thumb 이라 IsDragging 을 쓴다.
        -->
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Strip" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                                       Fill="{StaticResource Brush.Border}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.DropValid}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.DropValid}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Strip" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center"
                                       Margin="6,0" Fill="{StaticResource Brush.Border}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Height" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.DropValid}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Height" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.DropValid}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 런처 카드의 폴더 구성 칩 -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- breadcrumb 조각 / 헤더 버튼 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
