<Application x:Class="FolderDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FolderDeck.App.Converters">
    <!-- StartupUri 를 쓰지 않는다. 설정을 먼저 읽어 런처/메인 중 무엇을 띄울지 정한다(App.xaml.cs). -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- 색은 전부 여기서 온다. 컨트롤에 #RRGGBB 를 직접 쓰지 않는다.
                 테마 교체는 시작 시 딕셔너리를 골라 병합하는 방식이며 런타임 교체는 지원하지
                 않는다 — 아래 참조가 전부 StaticResource 다(DynamicResource 0건).
                 근거는 doc/FolderDeck_familylook_spec.md §7. 토큰 이름 규약은 같은 문서 §3·§4. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:CollapsibleRowHeightConverter x:Key="RowHeight" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:WiderThanConverter x:Key="WiderThan" />
            <conv:TileGapToMarginConverter x:Key="TileMargin" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            리스트 행처럼 보이는 넓적한 버튼. 폴더 행 말고 접기 헤더·팝업 항목도 이 모양을 쓴다.
            그래서 여기에는 <b>폴더 행에만 있는 속성에 대한 바인딩을 두지 않는다</b> —
            DataContext 가 행이 아닌 곳에서 매번 바인딩 오류가 난다(실제로 그랬다).
            행 전용 강조는 아래 FolderListRowButton 에 있다.
        -->
        <Style x:Key="FolderRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            왼쪽 폴더 리스트의 행 — 지금 순환 칸에 떠 있는 폴더를 강조한다.
            템플릿의 Back 은 TemplateBinding Background 를 쓰므로 여기서 Background 만 바꾸면 되고,
            마우스 오버는 템플릿 트리거라 그 위를 덮는다(손이 올라간 쪽이 이겨야 맞다).
        -->
        <Style x:Key="FolderListRowButton" TargetType="Button" BasedOn="{StaticResource FolderRowButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsShowingInRotating}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.RowActive}" />
                </DataTrigger>
                <!-- 끌어온 파일이 이 행 위에 있다 (§4.2-2). Phase 2 의 빈 칸 과녁과 같은 파랑이라
                     "여기에 놓인다"가 같은 색으로 읽힌다. 순환 칸 강조보다 뒤에 둬서 이긴다 —
                     드래그 중에는 이쪽이 답이다. -->
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            헤더 내비 클러스터의 아이콘 버튼 — ← → ↑ ⌂ ⟳ 🔍 가 같은 크기·모양으로 보여야
            "눌러진다"가 자명해진다.
        -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            행 안에 겹쳐 두는 작은 조작 버튼 — 지금은 폴더 등록 제거의 「✕」 하나다 (D38 · §4.11-2).
            평소에는 없다. 그 행에 손이 올라가거나 키보드 초점이 들어왔을 때만 나타난다 —
            열 줄짜리 목록에 ✕ 열 개가 늘 떠 있으면 목록이 아니라 삭제 화면으로 읽힌다.
            색은 중립이다. 위험을 말하는 일은 확인창이 맡는다 — 무엇이 같이 정리되는지 세어
            보이는 쪽이 빨간 글리프보다 정확하다.
            AncestorType=Button 은 이 버튼이 아니라 <b>행 버튼</b>을 잡는다(FindAncestor 는 부모부터
            올라간다). 겹쳐 두었으므로 그 행 위 어디에 손이 있어도 조건이 선다.
            <b>배치 편집 중에는 아예 뜨지 않는다</b> (D39). 그때 행은 끌어다 놓는 물건이지 지우는
            물건이 아니다. 실물에서도 둘이 어긋났다 — 드래그가 마우스를 캡처해 커서가 떠나도
            IsMouseOver 가 true 로 남고, PreviewMouseMove 가 터널링이라 「✕」를 잡아 끌면 행
            드래그가 시작된다. 표시 조건 하나로 둘 다 닫힌다.
            AncestorType=Window 의 DataContext 는 MainViewModel 이다 — 같은 「✕」가
            RemoveFolderCommand 를 잡을 때 쓰는 경로와 같다.
        -->
        <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True"
                                   Binding="{Binding IsMouseOver,
                                             RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Condition Value="False"
                                   Binding="{Binding DataContext.IsEditingLayout,
                                             RelativeSource={RelativeSource AncestorType=Window}}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Value="True"
                                   Binding="{Binding IsKeyboardFocusWithin,
                                             RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Condition Value="False"
                                   Binding="{Binding DataContext.IsEditingLayout,
                                             RelativeSource={RelativeSource AncestorType=Window}}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            좁은 타일에서 아이콘을 접는 두 단계.

            1x1 타일은 작은 창에서 100px 도 안 되는데 내비 아이콘 6개만 144px 다. 그대로 두면
            잘리고, 잘리지 않게 breadcrumb 을 밀어내면 이번엔 <b>폴더 이름</b>이 사라진다 —
            이름이 아이콘보다 중요하다. 그래서 대체 조작이 있는 것부터 순서대로 접는다.

            240px 아래: 뒤로 · 앞으로(마우스 XButton, Alt+←/→) · 다시 읽기(F5)
            170px 아래: 상위(Alt+↑) · 검색(Ctrl+F)
            끝까지 남는 것: 앵커 복귀(⌂) — breadcrumb 이 잘리면 첫 조각 클릭도 못 하므로
            집으로 돌아갈 길이 아예 없어진다.
        -->
        <Style x:Key="SecondaryNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="240" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TertiaryNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="170" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            🔍 — 열려 있는 동안 눌린 표시. ToggleButton 을 쓰지 않는 이유:
            클릭하면 WPF 가 IsChecked 에 "로컬 값"을 심는데, 그 로컬 값이 OneWay 바인딩을
            영구히 이겨버린다. 그러면 포커스가 빠져 검색줄이 접힌 뒤에도 버튼만 눌린 채로 남는다
            (실제로 그렇게 어긋나는 것을 확인했다). 상태는 뷰모델만 갖고, 여기서는 그리기만 한다.
        -->
        <Style x:Key="NavToggleButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchExpanded}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.RowActive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 검색 토글도 같은 단계에서 접힌다(모양만 NavToggleButton 을 따른다). -->
        <Style x:Key="TertiaryNavToggleButton" TargetType="Button"
               BasedOn="{StaticResource NavToggleButton}">
            <Style.Triggers>
                <DataTrigger Value="False">
                    <DataTrigger.Binding>
                        <Binding RelativeSource="{RelativeSource AncestorType=UserControl}"
                                 Path="ActualWidth"
                                 Converter="{StaticResource WiderThan}"
                                 ConverterParameter="170" />
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            툴바의 "배치 편집" 토글 (Phase 2). NavToggleButton 과 같은 이유로 ToggleButton 을
            쓰지 않는다: 클릭하면 WPF 가 IsChecked 에 로컬 값을 심고, 그 값이 OneWay 바인딩을
            영구히 이겨 버려 뷰모델 상태와 버튼 모양이 어긋난다. 상태는 뷰모델만 갖는다.
        -->
        <Style x:Key="EditModeButton" TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="3" BorderThickness="1"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <!-- 편집 중임이 버튼에서도 바로 보이게 — 눌린 모양으로 남는다. -->
                            <DataTrigger Binding="{Binding IsEditingLayout}" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.EditChrome}" />
                                <Setter TargetName="Back" Property="BorderBrush"
                                        Value="{StaticResource Brush.Accent}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource Brush.EditChromeText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            스플리터 — 잡을 수 있는 자리임이 보여야 한다. 선은 1px 만 긋고 잡히는 띠는 6px 다
            (보이는 것보다 잡기 쉽게). 손을 올리면 선이 굵고 파래져 "여기서 끌린다"가 드러나고,
            끄는 동안에도 그 상태를 유지한다. GridSplitter 는 Thumb 이라 IsDragging 을 쓴다.
        -->
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Strip" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                                       Fill="{StaticResource Brush.Border}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Width" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="Strip" Background="{TemplateBinding Background}">
                            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center"
                                       Margin="6,0" Fill="{StaticResource Brush.Border}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Height" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Strip" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                                <Setter TargetName="Line" Property="Height" Value="2" />
                                <Setter TargetName="Line" Property="Fill"
                                        Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 런처 카드의 폴더 구성 칩 -->
        <Style x:Key="ChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- breadcrumb 조각 / 헤더 버튼 -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            워크스페이스 툴바의 순환 폴더 타일 (Phase 8-B 8 -> 8-C 2).

            8-B 는 LinkButton 으로 그렸는데 글자만 늘어놓은 줄로 보여 눌리는 것인 줄 몰랐다.
            테두리·면·손 커서·마우스 오버 넷을 함께 준다 — 넷이 다 있어야 "버튼"으로 읽힌다.

            색은 보라(Brush.Rotating) 계열이다. 런처 카드 3줄째의 순환 이름과 같은 색이고,
            메인 창 순환 칸 테두리와도 같은 뜻이다(색은 뜻 하나씩 — familylook 4.2).

            <b>테두리는 실선이다.</b> 순환 칸 타일은 점선인데 여기는 아니다: WPF Border 는
            점선을 못 그리고(그래서 타일 쪽은 Rectangle 로 그린다) 20px 높이 칩에서 점선은
            어차피 뭉개진다. 성격을 나르는 것은 여기서 색과 자리(순환 줄)다.

            지금 순환 칸에 떠 있는 폴더는 면을 채우고 글씨를 굵힌다 —
            <b>색만으로 말하지 않는다</b>(3.2). 왼쪽 목록 행 강조와 같은 값을 읽는다.
        -->
        <Style x:Key="RotatingTileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Rotating}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Rotating}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RotatingSurface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{StaticResource Brush.RotatingSurface}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
