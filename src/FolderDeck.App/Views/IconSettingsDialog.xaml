<Window x:Class="FolderDeck.App.Views.IconSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IconSettingsViewModel}"
        Title="설정"
        Width="420" Height="480"
        MinWidth="360" MinHeight="280"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        D59 — 설정 창. 지금은 탭 하나(「아이콘」)뿐이다. skipLauncher(런처 하단 체크박스)와
        타일 간격 고르개(배치 편집 툴바)는 이번 회차에 옮기지 않는다(결정 2) — 그래서 둘 다
        여기 없다.

        FontFamily 를 여기서 새로 지정하지 않는다 — WPF 기본 글꼴이 이미 Segoe UI 라 지정한
        자리 수를 늘리지 않고도(결정 8 검산표) 나머지 창과 같은 모양이 나온다.

        행을 더하고 지우는 목록은 LauncherWindow 의 NewFolders 조각(ObservableCollection +
        ItemsControl + ✕ + RelayCommand)을, 행 안 텍스트 편집은 WorkspaceCardViewModel 의
        IsEditing 조각을 본떴다(D58 Q4) — 「빈 행을 만들어 그 자리에서 타이핑」만 새로 짰다.
    -->
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="저장" Padding="16,5" Margin="0,0,8,0" IsDefault="True"
                    Click="OnAccept" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <TabItem Header="아이콘">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               FontSize="11" Foreground="{StaticResource Brush.TextSecondary}"
                               Text="확장자에 글리프 한 글자를 매핑한다. 비워 두면 지금과 같다 — 매핑에 없는 확장자는 그대로 📄 다. 폴더는 이 매핑과 무관하게 늘 📁 다." />

                    <Button DockPanel.Dock="Bottom" Content="＋ 행 추가" Padding="10,4"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="{Binding AddRowCommand}"
                            AutomationProperties.Name="행 추가"
                            ToolTip="빈 행을 하나 더한다 — 확장자와 글리프를 채워 넣는다." />

                    <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                            CornerRadius="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IconMappingRowViewModel}">
                                        <DockPanel Margin="4">
                                            <Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                                    Style="{StaticResource LinkButton}"
                                                    ToolTip="이 행을 지운다"
                                                    Command="{Binding DataContext.RemoveRowCommand,
                                                                      RelativeSource={RelativeSource
                                                                          AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <!-- 미리보기 — 결정 9. 입력한 글자가 그대로 보인다 —
                                                 없는 글리프(두부 □)를 코드로 막지 않고 여기서
                                                 눈으로 바로 확인하게 한다. -->
                                            <TextBlock DockPanel.Dock="Right" Width="28"
                                                       Margin="6,0" FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Glyph}"
                                                       ToolTip="미리보기 — 입력한 글자가 그대로 보인다" />

                                            <TextBox Width="90" Padding="4,3" Margin="0,0,6,0"
                                                     Text="{Binding Extension,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="확장자"
                                                     ToolTip="예: .pdf — 점·대소문자는 안 가린다" />

                                            <TextBox Padding="4,3"
                                                     Text="{Binding Glyph,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="글리프"
                                                     ToolTip="글자 하나(이모지도 된다)" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- D65 — 검색 타일은 이 회차에서 만들지 않는다(결정 8). 상태 한 줄뿐이다. -->
            <TabItem Header="검색">
                <StackPanel x:Name="EverythingTabContent" Margin="10">
                    <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
