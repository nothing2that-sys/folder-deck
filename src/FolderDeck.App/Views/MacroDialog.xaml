<Window x:Class="FolderDeck.App.Views.MacroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="매크로 만들기"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        매크로 규칙 한 벌 (§4.7). 항목 순서가 §4.7 의 JSON 모양 그대로다:
        name / op / source / dest / onConflict / confirm.

        값은 지금 화면 상태로 미리 채워져 뜬다 — 방금 손으로 한 조작을 굳히는 것이
        주 용도라, 대개는 이름만 쓰고 확인을 누르게 된다.
    -->
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="2,2,0,2" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock Text="이름" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Padding="5,4" />

        <TextBlock Text="동작" Style="{StaticResource FieldLabel}" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="OpCopy" GroupName="Op" Content="복사" Margin="2,2,14,2"
                         Checked="OnOpChanged" />
            <RadioButton x:Name="OpMove" GroupName="Op" Content="이동" Margin="0,2,14,2"
                         Checked="OnOpChanged"
                         ToolTip="원본이 사라진다. 목적지가 하나여야 하고 확인을 끄지 못한다." />
            <RadioButton x:Name="OpTrash" GroupName="Op" Content="휴지통" Margin="0,2"
                         Checked="OnOpChanged"
                         ToolTip="목적지가 없다. 되돌릴 수 있지만 확인을 끄지 못한다." />
        </StackPanel>

        <TextBlock Text="대상" Style="{StaticResource FieldLabel}" />
        <RadioButton x:Name="SourceSelection" GroupName="Source"
                     Content="실행할 때 그리드에서 고른 것" />
        <RadioButton x:Name="SourceFixed" GroupName="Source">
            <StackPanel>
                <TextBlock Text="이 경로로 고정" />
                <TextBlock x:Name="FixedPathText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
        </RadioButton>

        <TextBlock x:Name="DestLabel" Text="목적지" Style="{StaticResource FieldLabel}" />
        <StackPanel x:Name="DestGroup">
            <RadioButton x:Name="DestTray" GroupName="Dest"
                         Content="대상함에서 그때 체크된 폴더"
                         ToolTip="실행할 때의 체크 상태를 따른다" />
            <RadioButton x:Name="DestFolders" GroupName="Dest"
                         Content="지금 체크된 폴더로 고정"
                         ToolTip="지금 체크된 폴더를 규칙에 굳힌다 — 나중에 체크가 바뀌어도 그대로다" />
            <RadioButton x:Name="DestVisible" GroupName="Dest"
                         Content="화면에 보이는 모든 폴더"
                         ToolTip="앵커가 아니라 그때 타일에 떠 있는 경로가 대상이다" />
        </StackPanel>

        <TextBlock Text="같은 이름이 있으면" Style="{StaticResource FieldLabel}" />
        <StackPanel x:Name="ConflictGroup" Orientation="Horizontal">
            <RadioButton x:Name="ConflictOverwrite" GroupName="Conflict" Content="덮어쓰기"
                         Margin="2,2,14,2" />
            <RadioButton x:Name="ConflictSkip" GroupName="Conflict" Content="건너뛰기"
                         Margin="0,2,14,2" />
            <RadioButton x:Name="ConflictRename" GroupName="Conflict" Content="둘 다 두기"
                         Margin="0,2" />
        </StackPanel>

        <CheckBox x:Name="ConfirmBox" Margin="0,16,0,0"
                  Content="실행 전에 미리보기로 확인" />
        <TextBlock x:Name="ConfirmNote" FontSize="11" Margin="22,2,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   Text="이동·휴지통은 확인을 끄지 못한다." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="만들기" Padding="16,5" Margin="0,0,8,0" IsDefault="True"
                    Click="OnAccept" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
