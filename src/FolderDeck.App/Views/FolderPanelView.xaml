<UserControl x:Class="FolderDeck.App.Views.FolderPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
             xmlns:v="clr-namespace:FolderDeck.App.Views"
             xmlns:models="clr-namespace:FolderDeck.Core.Models;assembly=FolderDeck.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderPanelViewModel}"
             Focusable="True"
             PreviewMouseDown="OnPreviewMouseDown"
             PreviewMouseMove="OnPanelPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPanelPreviewMouseLeftButtonUp"
             LostMouseCapture="OnPanelLostMouseCapture"
             DataContextChanged="OnDataContextChanged"
             AllowDrop="True"
             DragEnter="OnTileDragOver"
             DragOver="OnTileDragOver"
             DragLeave="OnTileDragLeave"
             Drop="OnTileDrop"
             Margin="4">

    <!-- 앵커 복귀 Alt+Home, 상위 Alt+↑, 뒤로/앞으로 Alt+←/→.
         마우스 XButton1/2 는 코드 비하인드에서 받는다. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Alt" Key="Home" Command="{Binding GoToAnchorCommand}" />
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding GoUpCommand}" />
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
        <!-- 이름 바꾸기 F2 (§4.6 309행 · A군 ② D16). 창(MainWindow) 층이 아니라 여기다:
             대상은 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             인자를 안 받는 RenameSelectionCommand 가 선택에서 대상을 뽑아 메뉴와 같은 경로로
             들어간다 — KeyBinding 에는 넘길 항목이 없다. -->
        <KeyBinding Key="F2" Command="{Binding RenameSelectionCommand}" />
        <!-- 복사 Ctrl+C (§4.6 310행 · A군 ③ C-1). F2 와 같은 이유로 창이 아니라 여기다:
             대상이 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             「경로 복사」(글자)와 다른 커맨드다 — 이쪽은 셸 파일 포맷을 싣는다. -->
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopySelectionToClipboardCommand}" />
        <!-- 잘라내기 Ctrl+X (D36). Ctrl+C(39행)와 같은 층·같은 이유다:
             대상이 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             D20("Ctrl+X 는 넣지 않는다")은 붙여넣기가 이동을 처리하게 되면서 폐기됐다. -->
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutSelectionToClipboardCommand}" />
        <!-- 붙여넣기 Ctrl+V (§4.6 330~336행 · A군 ③ C-2). 여기 두는 이유는 Ctrl+C 와 다르다:
             대상이 "고른 항목"이 아니라 "이 패널이 지금 보고 있는 폴더"라서다(§4.9 442행).
             창에 물리면 어느 타일에 붙여넣을지 가릴 수 없는 것은 마찬가지다. -->
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteIntoCurrentCommand}" />
        <!-- Ctrl+F 는 펴는 것으로 끝이 아니라 포커스까지 줘야 하고, 갓 보이게 된 TextBox 는
             레이아웃 뒤에야 포커스를 받는다. 그래서 MainWindow 코드 비하인드가 처리한다. -->
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- 항목 우클릭 메뉴는 여기 없다 — 셸이 준 HMENU 를 코드 비하인드가 그대로 띄운다
             (§4.6 · D32 상시 병합). WPF ContextMenu 로는 셸 확장 항목을 그릴 수 없다:
             확장은 IContextMenu2/3 메시지를 받아야 자기 서브메뉴를 채운다.
             자리는 Views/FolderPanelView.xaml.cs 의 OnItemPreviewRightButtonUp 이다. -->

        <Style x:Key="FileItemContainer" TargetType="ListViewItem">
            <!-- 행의 히트 영역을 내용 폭까지로 좁힌다 (§4.2-2 · Stage 3C).

                 WPF 는 행을 패널 가로 폭 전체로 늘린다. 컬럼 합은 480px 뿐인데 그 오른쪽 눈에
                 보이는 빈 면적까지 히트테스트가 이 컨테이너를 주므로, 목록이 세로로 꽉 차면
                 고무줄을 시작할 빈 곳이 하나도 남지 않았다.

                 실측(뷰포트 444 · 컬럼 합 180 · 같은 좌표 x=220):
                   늘어난 채 → Item  | Border ← ListViewItem ← VirtualizingStackPanel ← …
                   좁힌 뒤   → Empty | ScrollViewer ← ListBoxChrome ← ListView
                 좁히면 그 오른쪽은 §4.2-2 의 "빈 곳"이 되어 고무줄이 시작된다.

                 Template 을 다시 쓰지 않는 이유: 상세 뷰의 컬럼은 GridView 가 테마 스타일로
                 공급하는 GridViewRowPresenter 가 그린다. 여기에 Template 을 박으면 컬럼이 죽고
                 두 뷰 방식에 스타일을 갈라 써야 한다 — 그것이 이 스타일 하나로 둘을 덮는 이유다.
                 폭을 숫자로 박지도 않는다: 컬럼이 바뀌면 내용 폭이 따라와야 한다. -->
            <Setter Property="HorizontalAlignment" Value="Left" />

            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <!-- 끌어내기 (§4.2-2): 누른 자리를 기억했다가 임계값을 넘으면 드래그로 본다. -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemPreviewMouseDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemPreviewMouseUp" />
            <EventSetter Event="PreviewMouseMove" Handler="OnItemPreviewMouseMove" />
            <!-- 우클릭 두 단계 (§4.6 · D32): 누를 때 선택을 잡고, 놓을 때 셸 메뉴를 띄운다. -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnItemPreviewRightButtonUp" />

            <Style.Triggers>
                <!-- 고른 항목은 포커스가 있든 없든 같은 색이다 (§4.2-1 · Stage 3C).

                     기본 템플릿은 Selector.IsSelectionActive 로 갈라, 목록에 키보드 포커스가
                     없으면 #ECECEC 로 그린다 — 흰 배경과 구분되지 않아 고른 것이 안 골라진 것처럼
                     보였다(실측: 비활성 #FFECECEC / 활성 #FFCCEFFE). 타일 여럿이 동시에 보이는
                     덱이라 다른 타일을 눌러 포커스가 떠나도 선택은 보여야 한다.

                     Template 을 다시 쓰지 않고 Style 트리거로 준다 — WPF 값 우선순위에서 Style
                     트리거가 테마 템플릿의 트리거를 이긴다(실측으로 확인했다). 그래서 컬럼을
                     그리는 GridViewRowPresenter 도, 기본 마우스 오버도 그대로 살아 있다. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SelectionSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 항목 앞 글리프 (Phase 8-B 3 -> 8-C 1). 세 자리(상세·검색·list)가 같은 것을 그리므로
             스타일 하나로 묶는다 — 색을 또 손볼 때 고칠 자리가 하나다.

             <b>폴더와 파일을 가르는 것은 여기, 색이다.</b> 글리프는 어휘표대로 되돌렸고
             (FileItemViewModel.Glyph) 그 둘은 WPF 에서 비슷한 굵기의 윤곽선이라 형태만으로는
             약하다. 황토(폴더) 대 무채색(파일)이면 훑는 눈에 폴더가 먼저 걸린다 —
             목록에서 소수인 쪽이 튀어나오는 것이 맞다.

             기본값을 파일 쪽에 두고 폴더를 트리거로 덮는다. 반대로 두면 IsDirectory 가
             false 인 쪽에 트리거를 하나 더 달아야 한다. -->
        <Style x:Key="ItemGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Glyph}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.FileGlyph}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.FolderGlyph}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 정렬되는 컬럼 머리 (Phase 8-B 1).

             GridViewColumn 은 시각 트리 밖이라 DataContext 를 물려받지 않는다 — 그래서
             Header 에 바인딩을 걸 수 없다. HeaderTemplate 안은 다르다: 거기 그려지는 요소는
             GridViewColumnHeader 밑이고 그것은 ListView 의 자손이라, ListView 를 타고 올라가면
             패널 뷰모델에 닿는다. 컬럼마다 읽는 프로퍼티만 다르고 나머지는 같다.

             화살표는 지금 정렬 중인 컬럼에만 붙는다 — 붙이고 떼는 판정은 전부 뷰모델
             (HeaderTextFor)이 하고 여기서는 글자를 받아 그리기만 한다. 헤더 메타의 정렬
             글자와 같은 재료(SortLabel·SortArrow)에서 나오므로 둘이 어긋날 수 없다.

             누름은 여기가 아니라 ListView 의 GridViewColumnHeader.Click 하나가 받는다
             (아래 DetailsList). 어느 기준인지는 컬럼에 붙은 v:ColumnSort.SortKey 가 말한다. -->
        <DataTemplate x:Key="NameColumnHeader">
            <TextBlock Text="{Binding DataContext.NameHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>
        <DataTemplate x:Key="SizeColumnHeader">
            <TextBlock Text="{Binding DataContext.SizeHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>
        <DataTemplate x:Key="ModifiedColumnHeader">
            <TextBlock Text="{Binding DataContext.ModifiedHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>

        <!-- 평소 details 뷰. GridView 는 여러 ListView 가 나눠 쓸 수 없어(런타임 InvalidOperationException)
             x:Shared="False" 로 조회마다 새 인스턴스를 받는다 — 패널이 3개고 검색 시 뷰를 갈아타므로.

             폭은 여기 적은 것이 출발값이고, 표시된 컬럼 하나는 타일 폭에 맞춰 코드가 다시 쓴다
             (§3.2 · Stage 3D-2 — GridView 는 star 를 지원하지 않는다). 늘리는 것은 `이름` 하나다:
             `크기`·`수정` 은 내용이 고정적이라 늘릴 이유가 없다. 오른쪽에는 여백을 남긴다 —
             꽉 맞추면 단계 C 가 만든 고무줄 시작 자리가 사라진다(ColumnLayout.RightMargin). -->
        <GridView x:Key="NormalGridView" x:Shared="False">
            <!-- 머리 셋 다 눌러서 정렬한다 (Phase 8-B 1). 같은 컬럼을 다시 누르면 방향이
                 뒤집히는데, 그 규칙은 여기가 아니라 SetSortCommand 안에 이미 있던 것이다. -->
            <GridView.ColumnHeaderContainerStyle>
                <Style TargetType="GridViewColumnHeader"
                       BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="ToolTip"
                            Value="눌러서 이 열로 정렬 — 같은 열을 다시 누르면 오름/내림이 뒤집힌다" />
                </Style>
            </GridView.ColumnHeaderContainerStyle>

            <GridViewColumn Header="이름" Width="260" v:ColumnLayout.IsFlexible="True"
                            HeaderTemplate="{StaticResource NameColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Name}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ItemGlyph}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="크기" Width="90"
                            HeaderTemplate="{StaticResource SizeColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Size}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="수정" Width="130" DisplayMemberBinding="{Binding ModifiedText}"
                            HeaderTemplate="{StaticResource ModifiedColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Modified}" />
        </GridView>

        <!-- 재귀 검색 중 details 뷰 — "위치" 열이 붙는다(탐색기 방식).
             여기서 늘리는 것은 `위치` 다 — 가장 긴 내용이 거기다(하위 폴더 상대 경로). -->
        <GridView x:Key="SearchGridView" x:Shared="False">
            <!-- 여기 컬럼에는 v:ColumnSort.SortKey 를 붙이지 않는다 — 재귀 검색 결과는 찾은
                 순서대로 흘러들고 정렬하지 않으므로(4.10) 눌러도 순서가 안 바뀐다.
                 헤더 메타의 정렬 글자를 그동안 잠그는 것과 같은 이유다. -->
            <GridViewColumn Header="이름" Width="220">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ItemGlyph}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="위치" Width="180" v:ColumnLayout.IsFlexible="True">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding RelativeFolder}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   ToolTip="{Binding FullPath}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="크기" Width="80">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="수정" Width="120" DisplayMemberBinding="{Binding ModifiedText}" />
        </GridView>
    </UserControl.Resources>

    <Grid>
        <!-- 상시 = 실선(호박), 순환 = 점선(보라). Border 는 점선을 못 그리므로 Rectangle 로 그린다. -->
        <!-- Fill 은 스타일에서만 준다. 로컬 값을 주면 스타일 트리거를 영구히 이겨 과녁의
             면 색이 켜지지 않는다 (MainWindow.xaml 대상함 항목과 같은 사고 — WPF 값 우선순위). -->
        <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="2">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.Pinned}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRotating}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Brush.Rotating}" />
                            <Setter Property="StrokeDashArray" Value="4 2.5" />
                        </DataTrigger>
                        <!-- 셸에서 끌어온 것이 이 타일 위에 있다 (§4.9). 폴더 행·대상함과 같은
                             파랑이라 "여기에 놓인다"가 같은 색으로 읽힌다. 상시/순환 강조보다
                             뒤에 둬서 이긴다 — 드래그 중에는 이쪽이 답이다. -->
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Fill" Value="{StaticResource Brush.AccentSurface}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- 테두리만으로는 큰 타일에서 눈에 안 띄어 말로도 적는다 (§4.2-2 와 같은 글귀).
             목록 위에 떠야 하므로 형제 중 마지막이 아니라 여기 두고 Panel.ZIndex 로 올린다.
             IsHitTestVisible="False" — 이것이 없으면 깜빡인다. WPF 는 드래그 이벤트를 히트테스트로
             찾은 <b>자손</b>에 올리고 그것이 이 컨트롤까지 버블한다. 그래서 커서가 이 글귀 위로
             올라가면 아래 요소가 DragLeave 를 받고(→ IsDropTarget=false → 글귀가 사라짐) 다시
             DragOver(→ true → 글귀가 뜸)가 되어 제자리에서 진동한다. 과녁은 보이기만 하면 된다. -->
        <Border Panel.ZIndex="1" IsHitTestVisible="False"
                Background="{StaticResource Brush.AccentSurface}"
                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1.5"
                CornerRadius="3" Padding="10,4"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="여기에 놓기" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent}" />
        </Border>

        <!-- 아직 아무 폴더도 안 띄운 순환 칸. 순환 칸이 여럿이면 제목이 번호를 밝힌다
             (예: "순환2 — 폴더를 지정하세요"). -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center"
                       Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock Text="왼쪽 목록에서 폴더를 클릭" FontSize="11" TextAlignment="Center"
                       Margin="0,3,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- IsEmpty 의 반대로 보여야 하므로 로컬 Visibility 대신 Style 트리거를 쓴다
             (로컬 값이 있으면 트리거가 이기지 못한다). -->
        <DockPanel Margin="10,8">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- ── 헤더: breadcrumb + 뒤로/앞으로/상위/앵커 + 메타 + 검색 ── -->
            <StackPanel DockPanel.Dock="Top">
                <!-- DockPanel 이 아니라 Grid 다. DockPanel 은 남는 자리를 breadcrumb 에 주는데,
                     breadcrumb 은 줄어들 줄 모르고 그 위로 넘쳐 그려서 내비 아이콘을 덮었다.
                     Auto 열은 제 폭을 먼저 가져가므로 아이콘이 잘리지 않고, 대신 breadcrumb
                     쪽(* 열)이 잘린다 — 잘려도 되는 것은 그쪽이다. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 이름 자리는 최소한 남긴다 — 아이콘을 다 보여주려다 이름을 지우면 안 된다. -->
                        <ColumnDefinition Width="*" MinWidth="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 내비 클러스터 — 🔍 를 같은 크기로 여기 붙여서 "눌러진다"가 자명하게.

                         Phase 8-C ③ 에서 <b>뷰 방식·정렬</b> 아이콘이 여기로 올라왔다(2줄째
                         글자였다). 아이콘이 여섯에서 여덟이 되므로 폭을 24 → 20 으로 좁힌다 —
                         "아이콘 사이 간격을 줄인다"가 그 뜻이고, 좁혀야 1줄이 감당한다.
                         Width 를 스타일에 넣지 않고 여기 로컬 값으로 준 이유: NavButton 은
                         MainWindow 의 툴바·행 「✕」도 쓰는 공용 스타일이라 거기까지 좁아진다.

                         접히는 단계는 그대로다(App.xaml 의 Secondary/Tertiary 주석). 새 둘은
                         Tertiary 에 얹었다 — 뷰 방식은 대체 조작이 없지만, 그 단계는 이미
                         「상위」와 「검색」도 접는 폭이라 거기서는 ⌂ 하나만 남기는 것이 결이다. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryNavButton}" Width="20"
                                Command="{Binding GoBackCommand}"
                                AutomationProperties.Name="뒤로"
                                ToolTip="뒤로 (마우스 뒤로 버튼 · Alt+←)" Content="←" />
                        <Button Style="{StaticResource SecondaryNavButton}" Width="20"
                                Command="{Binding GoForwardCommand}"
                                AutomationProperties.Name="앞으로"
                                ToolTip="앞으로 (마우스 앞으로 버튼 · Alt+→)" Content="→" />
                        <Button Style="{StaticResource TertiaryNavButton}" Width="20"
                                Command="{Binding GoUpCommand}"
                                IsEnabled="{Binding CanGoUp}"
                                AutomationProperties.Name="상위 폴더"
                                ToolTip="상위 폴더 (Alt+↑)" Content="↑" />
                        <Button Style="{StaticResource NavButton}" Width="20"
                                Command="{Binding GoToAnchorCommand}"
                                AutomationProperties.Name="앵커로 복귀"
                                ToolTip="앵커로 복귀 (Alt+Home)" Content="⌂" />
                        <Button Style="{StaticResource SecondaryNavButton}" Width="20"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="다시 읽기"
                                ToolTip="다시 읽기 (F5)" Content="⟳" />

                        <!-- 뷰 방식 토글 (§3.2). 상태를 보여 주는 곳과 바꾸는 곳이 같다 —
                             글자가 아이콘이 됐을 뿐 커맨드도 뜻도 그대로다. -->
                        <Button Style="{StaticResource TertiaryNavButton}" Width="20"
                                Command="{Binding ToggleViewModeCommand}"
                                Content="{Binding ViewModeIcon}"
                                AutomationProperties.Name="뷰 방식 전환"
                                ToolTip="{Binding ViewModeTip}" />

                        <!-- 정렬 (부채 17 · Phase 8-C ③). 아이콘은 방향(▴/▾)과 통합(∪)만
                             말하고 기준은 툴팁과 열리는 메뉴가 말한다 — 네 기준에 글리프를
                             하나씩 붙이면 어휘표가 이 앱 쪽으로 비대해진다(familylook §6).
                             ∪ 가 2줄째와 함께 사라진 " · 통합" 표시가 간 자리다.

                             폭만 Auto 다: 통합일 때 두 글자(∪▾)가 된다.

                             WPF ContextMenu 는 우클릭에만 저절로 열리므로 Click 이 IsOpen 을
                             세운다(코드 비하인드는 그 일만 한다). 값을 정하는 것은 전부
                             SetSortCommand 안이다. ContextMenu 는 시각 트리 밖이라
                             DataContext 가 안 내려온다 — Tag 로 패널 VM 을 잡는다.
                             재귀 검색 중에는 잠근다: 그 결과는 찾은 순서대로 흘러들고 정렬하지
                             않으므로(§4.10) 기준을 바꿔도 순서가 안 바뀐다 — 아이콘만 바뀌면
                             거짓말이 된다. 잠긴 모양은 NavButton 이 이미 갖고 있다
                             (IsEnabled=False → Opacity 0.35). -->
                        <Button Style="{StaticResource TertiaryNavButton}"
                                Width="Auto" MinWidth="20" Padding="2,0"
                                Click="OnSortTextClick"
                                Content="{Binding SortIcon}"
                                IsEnabled="{Binding IsRecursiveSearch, Converter={StaticResource InverseBool}}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="정렬 기준 변경"
                                ToolTip="{Binding SortTip}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.ContextMenu>
                                <!-- 라벨은 SortLabel 이 쓰는 네 단어 그대로다. 방향(▴/▾)은
                                     아이콘이 이미 말하므로 메뉴에 다시 적지 않는다. -->
                                <ContextMenu>
                                    <MenuItem Header="이름"
                                              Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:SortBy.Name}" />
                                    <MenuItem Header="수정"
                                              Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:SortBy.Modified}" />
                                    <MenuItem Header="크기"
                                              Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:SortBy.Size}" />
                                    <MenuItem Header="종류"
                                              Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:SortBy.Type}" />
                                    <Separator />
                                    <!-- 폴더 먼저 끄기 = 통합 정렬 (Phase 8-B ②). 위 넷과 성격이
                                         달라(무엇으로 대 어떻게 묶어) 구분선 아래에 둔다.
                                         체크는 한쪽 방향이다 — 값을 바꾸는 길은 커맨드 하나뿐이고
                                         그것이 목록을 다시 읽는다. 양방향으로 묶으면 메뉴가 값만
                                         바꾸고 목록은 옛 순서로 남는 길이 생긴다.
                                         저장하지 않는다: 워크스페이스 스키마에 슬롯이 없다. -->
                                    <MenuItem Header="폴더 먼저" IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.FoldersFirst,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Mode=OneWay}"
                                              Command="{Binding PlacementTarget.Tag.ToggleFoldersFirstCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              ToolTip="끄면 폴더와 파일을 한 덩어리로 정렬한다 — 아이콘에 ∪ 가 붙는다 (창을 다시 열면 켜진 상태로 돌아온다)" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Style="{StaticResource TertiaryNavToggleButton}" Width="20"
                                Click="OnSearchToggleClick"
                                AutomationProperties.Name="검색"
                                ToolTip="검색 (Ctrl+F)" Content="🔍" />
                    </StackPanel>

                    <!-- 폴더 이름 줄 = breadcrumb + 개수 (Phase 8-C ③).

                         개수가 2줄째에서 여기로 올라왔다. <b>개수를 오른쪽에 도킹하고
                         breadcrumb 이 남는 자리를 먹는다</b> — 반대로 두면(개수가 이름 바로 뒤)
                         경로가 길어질 때 개수가 먼저 잘려 나간다. 잘려도 되는 것은 경로 쪽이고
                         (그쪽은 툴팁·앵커 복귀로 되찾을 수 있다) 개수는 늘 보여야 한다.
                         Auto 열을 새로 만들지 않은 이유도 같다: 열을 만들면 개수가 이름 칸의
                         MinWidth 를 밀어 내비 아이콘이 잘리는 옛 사고로 돌아간다. -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCountText}"
                                   Margin="6,0,4,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   ToolTip="{Binding MetaText}" />

                    <!-- breadcrumb: 첫 조각(앵커) 클릭 = 앵커 복귀. 우클릭 = 현재 경로 복사. -->
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}"
                                  VerticalAlignment="Center" ClipToBounds="True"
                                  ToolTip="우클릭: 지금 보고 있는 폴더의 경로 복사">
                        <ItemsControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="경로 복사" Command="{Binding CopyCurrentPathCommand}" />
                                <!-- 붙여넣기 (§4.6 330~336행 · A군 ③ C-2) — 목적지가 "지금 보고
                                     있는 폴더"라 항목 메뉴가 아니라 이 자리다. 항목을 우클릭한
                                     것이 아니므로 무엇에 붙여넣을지 헷갈리지 않는다.
                                     빈 곳(배경) 메뉴를 새로 만들지 않는다 — 고무줄 선택이
                                     그 자리를 쓴다(§4.2-2). -->
                                <MenuItem Header="붙여넣기"
                                          InputGestureText="Ctrl+V"
                                          Command="{Binding PasteIntoCurrentCommand}" />
                            </ContextMenu>
                        </ItemsControl.ContextMenu>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="›" Foreground="{StaticResource Brush.TextSecondary}"
                                               Margin="1,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource LinkButton}"
                                            Content="{Binding Name}"
                                            ToolTip="{Binding Path}"
                                            Command="{Binding DataContext.NavigateToCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}">
                                        <Button.Resources>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </DockPanel>
                </Grid>

                <!-- 2줄 = <b>지금 벌어지고 있는 일</b>만 (Phase 8-C ③).

                     개수·뷰 방식·정렬은 1줄로 올라갔다. 여기 남은 셋(앵커 밖 · 선택 · 읽는 중)은
                     평소에 하나도 없으므로 그때는 줄을 통째로 접어 헤더 높이를 돌려준다 —
                     1x1 타일에서 이 한 줄이 목록 두 행쯤 된다.

                     Visibility 를 로컬 값으로 준다(스타일 트리거가 아니라): 이 줄에는 IsEmpty
                     같은 반대 조건이 겹치지 않아 하나로 충분하다.
                     좁은 타일에서 넘치지 않게 잘라 낸다. -->
                <StackPanel Orientation="Horizontal" Margin="3,2,0,4" ClipToBounds="True"
                            Visibility="{Binding HasStatusLine,
                                         Converter={StaticResource BoolToVisibility}}">
                    <!-- 앞의 "·" 를 뗐다 (Phase 8-C ③): 개수·뷰·정렬이 1줄로 올라가면서
                         이 글귀가 줄의 첫 조각이 됐다 — 앞 조각이 없는데 구분점만 남으면
                         무엇에서 이어지는지 알 수 없는 점 하나가 뜬다. -->
                    <TextBlock Text="앵커 밖" Foreground="{StaticResource Brush.Rotating}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsAwayFromAnchor,
                                                    Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SelectionText}" FontSize="11" Margin="6,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Accent}"
                               Visibility="{Binding HasSelection,
                                                    Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="읽는 중…" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- 검색 줄 — 헤더 안이 아니라 헤더 "아래"에 한 줄로 펴진다.
                     헤더 안에서 좌우로 펴면 breadcrumb 길이에 따라 폭이 널뛴다.
                     기준점은 지금 보고 있는 폴더(currentPath). 이름 부분일치만.
                     되접힘은 컨테이너의 IsKeyboardFocusWithin 으로 본다 —
                     "하위 포함"이나 ✕ 로 포커스가 옮겨가도 접히지 않게. -->
                <DockPanel x:Name="SearchArea" Margin="0,2,0,6"
                           IsKeyboardFocusWithinChanged="OnSearchFocusWithinChanged"
                           Visibility="{Binding IsSearchExpanded,
                                        Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                            Command="{Binding CloseSearchCommand}"
                            AutomationProperties.Name="검색 닫기"
                            ToolTip="검색 닫기" Content="✕" />
                    <CheckBox DockPanel.Dock="Right" Content="하위 포함" VerticalAlignment="Center"
                              Margin="8,0,4,0" FontSize="11"
                              IsChecked="{Binding IncludeSubfolders}"
                              ToolTip="켜면 이 폴더 아래 트리를 재귀로 검색한다" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" FontSize="12" MinHeight="24"
                             VerticalContentAlignment="Center"
                             ToolTip="이름으로 검색 (대소문자 무시 · 부분일치)" />
                </DockPanel>
            </StackPanel>

            <!-- ── 접근 불가: 폴더를 목록에서 지우지 않고 상태 + 다시 시도 (§5) ── -->
            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,6" CornerRadius="3"
                    Background="{StaticResource Brush.DangerSurface}"
                    Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding FailureText}" Foreground="{StaticResource Brush.Danger}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentPath}" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="11" Margin="0,3" TextWrapping="Wrap" />
                    <Button Content="다시 시도" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 검색 진행 / 건너뜀 / 결과 없음 -->
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding SearchStatusText}" FontSize="11" Margin="3,4,0,0"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                <!-- 권한 없음·끊긴 네트워크로 못 본 하위가 있으면 한 줄로 알린다 (§5). -->
                <TextBlock Text="{Binding SkippedFoldersText}" FontSize="11" Margin="3,4,0,0"
                           Foreground="{StaticResource Brush.Danger}"
                           Visibility="{Binding HasSkippedFolders,
                                                Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- ListArea — 고무줄의 유일한 좌표계다 (§4.2-2 · Stage 3B). 사각형도 항목 사각형도
                 이 요소 기준으로만 잰다. 두 좌표계를 섞으면 스크롤된 목록에서 어긋난다. -->
            <Grid x:Name="ListArea">
                <!-- "검색 안 함"(평소 빈 폴더)과 구분되는 "결과 없음" -->
                <TextBlock Text="결과 없음" Foreground="{StaticResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- ── 파일 목록 · 가상화 켬 (§8 — 로그 수천 개 폴더에서 UI 멈춤 방지) ──
                     View 는 Style 로만 정한다(로컬 값을 주면 검색 시 열 교체 트리거가 이기지 못한다). -->
                <ListView x:Name="DetailsList" ItemsSource="{Binding DisplayItems}"
                          GridViewColumnHeader.Click="OnColumnHeaderClick"
                          ItemContainerStyle="{StaticResource FileItemContainer}"
                          BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                          ScrollViewer.ScrollChanged="OnDetailsScrollChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="View" Value="{StaticResource NormalGridView}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- 재귀 검색 중에는 "위치" 열이 붙은 뷰로 갈아탄다. -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDetailsView}" Value="True" />
                                        <Condition Binding="{Binding IsRecursiveSearch}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="View" Value="{StaticResource SearchGridView}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                </ListView>

                <ListView x:Name="SimpleList" ItemsSource="{Binding DisplayItems}"
                          ItemContainerStyle="{StaticResource FileItemContainer}"
                          BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource ItemGlyph}" />
                                <!-- list 뷰의 검색 결과는 이름 앞에 상대 폴더를 흐리게 붙인다. -->
                                <TextBlock Text="{Binding RelativeFolderPrefix}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Visibility="{Binding HasRelativeFolder,
                                                                Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 고무줄 사각형 (§4.2-2 · Stage 3B). 과녁 강조와 같은 토큰이라 "이 앱이 지금
                     무엇을 집고 있다"가 같은 파랑으로 읽힌다.
                     IsHitTestVisible="False" — 이것이 없으면 사각형이 자기 밑의 항목을 가려
                     판정이 자기 그림에 걸린다(Stage 1 의 과녁 강조 진동과 같은 사고).
                     ClipToBounds="True" — 캡처 중에는 커서가 목록 밖으로 나가므로 사각형이
                     목록 영역을 넘어 그려지지 않게 잘라 준다. -->
                <Canvas x:Name="BandLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="Band" Visibility="Collapsed"
                               Stroke="{StaticResource Brush.Accent}" StrokeThickness="1"
                               Fill="{StaticResource Brush.AccentSurface}" />
                </Canvas>
            </Grid>
        </DockPanel>

        <!-- 활성 링 — "지금 키보드가 이 타일에 있다" (Phase 5 「타일 포커스」 C-2).
             C-1 이 여백 다운으로 이 패널에 포커스를 주게 됐으니, 어느 타일이 그것을 가졌는지가
             화면에 보여야 한다.

             <b>기존 테두리 Rectangle(:243)을 건드리지 않는다.</b> 그 하나가 이미 면·상시/순환
             성격·드롭 과녁 셋을 Stroke/Fill 로 들고 있어서, 넷째를 얹으면 같은 속성을 두고
             트리거 우선순위를 다툰다(:241~242 주석과 같은 사고). 그래서 별 요소로 얹는다.

             Fill 을 주지 않는다 — 면은 기존 Rectangle 것이고 이것은 테두리만이다.
             IsHitTestVisible="False" — 이것이 클릭을 먹으면 C-1 이 무너진다(이 요소가 다운을
             가져가면 그 아래 목록·버튼이 못 받는다).

             Margin="4" 은 기존 테두리와 <b>2px 를 띄우려고</b> 고른 값이다: 기존 것이 타일
             가장자리 0~2px 를 쓰므로 Margin="2" 면 이 링이 곧바로 2~4px 를 이어 받아 두 겹이
             4px 한 줄로 붙어 보인다. 4 로 들이면 2(테두리)-2(빈틈)-2(링) 가 되어 갈린다.
             RadiusX/Y 는 기존 4 보다 작은 2 다 — 모서리 곡률까지 달라야 두 겹이 더 갈린다.

             Visibility 는 로컬 값이 아니라 Style 로 준다. 로컬 값을 주면 트리거가 이기지 못한다
             (:291~292 가 같은 이유로 같은 방법을 쓴다). 판정은 뷰의 IsKeyboardFocusWithin 을
             직접 읽는다 — 뷰모델에 새 활성 상태를 만들지 않는다(판정이 이미 SelectionOwner(선택)
             와 IsKeyboardFocusWithin(포커스) 둘로 갈라져 있어 셋째를 만들지 않는다).
             새 컨버터를 만들지 않는다 — DataTrigger 가 bool 을 그대로 본다. -->
        <Rectangle Margin="4" RadiusX="2" RadiusY="2" IsHitTestVisible="False"
                   Stroke="{StaticResource Brush.TileActive}" StrokeThickness="2">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
    </Grid>
</UserControl>
