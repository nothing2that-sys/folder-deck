<UserControl x:Class="FolderDeck.App.Views.FolderPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
             xmlns:v="clr-namespace:FolderDeck.App.Views"
             xmlns:interop="clr-namespace:FolderDeck.App.Interop"
             xmlns:models="clr-namespace:FolderDeck.Core.Models;assembly=FolderDeck.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderPanelViewModel}"
             Focusable="True"
             PreviewMouseDown="OnPreviewMouseDown"
             PreviewMouseMove="OnPanelPreviewMouseMove"
             PreviewMouseLeftButtonUp="OnPanelPreviewMouseLeftButtonUp"
             LostMouseCapture="OnPanelLostMouseCapture"
             DataContextChanged="OnDataContextChanged"
             AllowDrop="True"
             DragEnter="OnTileDragOver"
             DragOver="OnTileDragOver"
             DragLeave="OnTileDragLeave"
             Drop="OnTileDrop">

    <!-- 앵커 복귀 Alt+Home, 상위 Alt+↑, 뒤로/앞으로 Alt+←/→.
         마우스 XButton1/2 는 코드 비하인드에서 받는다. -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Alt" Key="Home" Command="{Binding GoToAnchorCommand}" />
        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding GoUpCommand}" />
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding GoBackCommand}" />
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding GoForwardCommand}" />
        <!-- 이름 바꾸기 F2 (§4.6 309행 · A군 ② D16). 창(MainWindow) 층이 아니라 여기다:
             대상은 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             인자를 안 받는 RenameSelectionCommand 가 선택에서 대상을 뽑아 메뉴와 같은 경로로
             들어간다 — KeyBinding 에는 넘길 항목이 없다. -->
        <KeyBinding Key="F2" Command="{Binding RenameSelectionCommand}" />
        <!-- 복사 Ctrl+C (§4.6 310행 · A군 ③ C-1). F2 와 같은 이유로 창이 아니라 여기다:
             대상이 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             「경로 복사」(글자)와 다른 커맨드다 — 이쪽은 셸 파일 포맷을 싣는다. -->
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopySelectionToClipboardCommand}" />
        <!-- 잘라내기 Ctrl+X (D36). Ctrl+C(39행)와 같은 층·같은 이유다:
             대상이 "이 패널에서 고른 항목"이라 창에 물리면 어느 패널의 선택인지 가릴 수 없다.
             D20("Ctrl+X 는 넣지 않는다")은 붙여넣기가 이동을 처리하게 되면서 폐기됐다. -->
        <KeyBinding Modifiers="Ctrl" Key="X" Command="{Binding CutSelectionToClipboardCommand}" />
        <!-- 붙여넣기 Ctrl+V (§4.6 330~336행 · A군 ③ C-2). 여기 두는 이유는 Ctrl+C 와 다르다:
             대상이 "고른 항목"이 아니라 "이 패널이 지금 보고 있는 폴더"라서다(§4.9 442행).
             창에 물리면 어느 타일에 붙여넣을지 가릴 수 없는 것은 마찬가지다. -->
        <KeyBinding Modifiers="Ctrl" Key="V" Command="{Binding PasteIntoCurrentCommand}" />
        <!-- 새 폴더 만들기 Ctrl+Shift+N(탐색기 표준, D75-d). Ctrl+V(줄 위)와 같은 이유로
             여기다: 대상이 "이 패널이 지금 보고 있는 폴더"라서 창에 물리면 어느 타일에
             만들지 가릴 수 없다. 인자를 안 받는 CreateNewFolderInteractiveCommand 가 검색
             타일 가드를 이미 안쪽에 갖고 있다(D75-b) — 여기서 따로 막지 않는다. -->
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding CreateNewFolderInteractiveCommand}" />
        <!-- Ctrl+F 는 펴는 것으로 끝이 아니라 포커스까지 줘야 하고, 갓 보이게 된 TextBox 는
             레이아웃 뒤에야 포커스를 받는다. 그래서 MainWindow 코드 비하인드가 처리한다. -->
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- 항목 우클릭 메뉴는 여기 없다 — 셸이 준 HMENU 를 코드 비하인드가 그대로 띄운다
             (§4.6 · D32 상시 병합). WPF ContextMenu 로는 셸 확장 항목을 그릴 수 없다:
             확장은 IContextMenu2/3 메시지를 받아야 자기 서브메뉴를 채운다.
             자리는 Views/FolderPanelView.xaml.cs 의 OnItemPreviewRightButtonUp 이다. -->

        <!-- 「지금 보고 있는 폴더」 메뉴 (§4.6 · D75). 정의는 여기 하나뿐이고 아래 두 자리
             (목록의 빈 곳 · breadcrumb)에서 같은 리소스를 연다(D75-c-4). x:Shared="False" 라
             각 자리가 자기 인스턴스를 받는다 — ContextMenu 는 FrameworkElement 라 논리 부모가
             하나뿐이므로, 같은 인스턴스를 두 소유자에게 그대로 붙이면 충돌한다.
             DataContext 는 breadcrumb 의 기존 ContextMenu 가 이미 그래 왔듯 — 코드 비하인드
             없이 Binding 만으로 소유 요소(PlacementTarget)의 DataContext(FolderPanelViewModel)
             를 그대로 물려받는다. 정렬 메뉴(§3.2 「정렬」)와 달리 Tag/PlacementTarget 우회가
             필요 없다.
             배치는 쓰기(새 폴더 만들기·붙여넣기) → 구분선 → 읽기(경로 복사) → 구분선 →
             워크스페이스(이 폴더를 앵커로 지정·새 폴더로 등록)다(D75-c-2) — 앞 둘은 파일
             시스템을, 뒤 둘은 워크스페이스를 바꿔 성격이 다르다. -->
        <ContextMenu x:Key="CurrentFolderMenu" x:Shared="False">
            <MenuItem Header="새 폴더 만들기" Command="{Binding CreateNewFolderInteractiveCommand}" />
            <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V"
                      Command="{Binding PasteIntoCurrentCommand}" />
            <Separator />
            <MenuItem Header="경로 복사" Command="{Binding CopyCurrentPathCommand}" />
            <Separator />
            <MenuItem Header="이 폴더를 앵커로 지정" Command="{Binding SetAnchorToCurrentCommand}" />
            <MenuItem Header="새 폴더로 등록" Command="{Binding RegisterCurrentFolderCommand}" />
        </ContextMenu>

        <!-- 컬럼 선택 메뉴 (§3.2 · Phase 15 · D79). 컬럼 머리글 우클릭 진입점 — 아래 두
             GridView 의 ColumnHeaderContainerStyle 세터로 붙는다. x:Shared="False" 라
             GridView 가 새 인스턴스를 받을 때(조회마다, §8) 이 메뉴도 자기 것을 받는다 —
             CurrentFolderMenu 와 같은 이유(위 62~65행)다. 한 GridView 안의 헤더 여럿(예:
             이름·크기·수정)이 같은 인스턴스를 나눠 쓰는 것은 괜찮다 — ContextMenu 는
             GridView 와 달리 여러 소유자에게 붙어도 충돌하지 않고, DataContext 도 소유
             헤더(PlacementTarget)의 것을 그대로 받는다(코드 비하인드 없이 Binding 만으로,
             CurrentFolderMenu 와 같다 — 실측으로 확인했다, D79-c 6-0).
             `이름` 항목은 넣지 않는다 — 끌 수 없다(D79b-7). `위치`는 검색 뷰에만 있는 열이라
             NeedsLocationColumn 으로 가른다(DetailsList 의 View 트리거가 같은 판정을 쓴다).
             체크는 한쪽 방향이다 — 값을 바꾸는 길은 커맨드 하나뿐이고 그것이 Entry(폴더
             타일) 나 런타임 필드(검색 타일)를 뒤집는다(D79-b·D79-b-fix). -->
        <ContextMenu x:Key="ColumnMenu" x:Shared="False">
            <MenuItem Header="크기" IsCheckable="True"
                      IsChecked="{Binding CurrentShowSize, Mode=OneWay}"
                      Command="{Binding ToggleShowSizeCommand}" />
            <MenuItem Header="수정" IsCheckable="True"
                      IsChecked="{Binding CurrentShowModified, Mode=OneWay}"
                      Command="{Binding ToggleShowModifiedCommand}" />
            <MenuItem Header="위치" IsCheckable="True"
                      IsChecked="{Binding CurrentShowPosition, Mode=OneWay}"
                      Command="{Binding ToggleShowPositionCommand}"
                      Visibility="{Binding NeedsLocationColumn, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <Style x:Key="FileItemContainer" TargetType="ListViewItem">
            <!-- 행의 히트 영역을 내용 폭까지로 좁힌다 (§4.2-2 · Stage 3C).

                 WPF 는 행을 패널 가로 폭 전체로 늘린다. 컬럼 합은 480px 뿐인데 그 오른쪽 눈에
                 보이는 빈 면적까지 히트테스트가 이 컨테이너를 주므로, 목록이 세로로 꽉 차면
                 고무줄을 시작할 빈 곳이 하나도 남지 않았다.

                 실측(뷰포트 444 · 컬럼 합 180 · 같은 좌표 x=220):
                   늘어난 채 → Item  | Border ← ListViewItem ← VirtualizingStackPanel ← …
                   좁힌 뒤   → Empty | ScrollViewer ← ListBoxChrome ← ListView
                 좁히면 그 오른쪽은 §4.2-2 의 "빈 곳"이 되어 고무줄이 시작된다.

                 Template 을 다시 쓰지 않는 이유: 상세 뷰의 컬럼은 GridView 가 테마 스타일로
                 공급하는 GridViewRowPresenter 가 그린다. 여기에 Template 을 박으면 컬럼이 죽고
                 두 뷰 방식에 스타일을 갈라 써야 한다 — 그것이 이 스타일 하나로 둘을 덮는 이유다.
                 폭을 숫자로 박지도 않는다: 컬럼이 바뀌면 내용 폭이 따라와야 한다. -->
            <Setter Property="HorizontalAlignment" Value="Left" />

            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
            <!-- 끌어내기 (§4.2-2): 누른 자리를 기억한다 — 임계 판정과 드래그 시작은 D71 부터
                 패널의 PreviewMouseMove·PreviewMouseLeftButtonUp(FolderPanelView.xaml 12·14행)
                 이 한다. 항목 컨테이너에 걸면 커서가 항목 밖으로 나갈 때 안 불려 씹혔다(D70). -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnItemPreviewMouseDown" />
            <!-- 우클릭 두 단계 (§4.6 · D32): 누를 때 선택을 잡고, 놓을 때 셸 메뉴를 띄운다. -->
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightButtonDown" />
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="OnItemPreviewRightButtonUp" />

            <Style.Triggers>
                <!-- 고른 항목은 포커스가 있든 없든 같은 색이다 (§4.2-1 · Stage 3C).

                     기본 템플릿은 Selector.IsSelectionActive 로 갈라, 목록에 키보드 포커스가
                     없으면 #ECECEC 로 그린다 — 흰 배경과 구분되지 않아 고른 것이 안 골라진 것처럼
                     보였다(실측: 비활성 #FFECECEC / 활성 #FFCCEFFE). 타일 여럿이 동시에 보이는
                     덱이라 다른 타일을 눌러 포커스가 떠나도 선택은 보여야 한다.

                     Template 을 다시 쓰지 않고 Style 트리거로 준다 — WPF 값 우선순위에서 Style
                     트리거가 테마 템플릿의 트리거를 이긴다(실측으로 확인했다). 그래서 컬럼을
                     그리는 GridViewRowPresenter 도, 기본 마우스 오버도 그대로 살아 있다. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.SelectionSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 항목 앞 글리프 (Phase 8-B 3 -> 8-C 1). 세 자리(상세·검색·list)가 같은 것을 그리므로
             스타일 하나로 묶는다 — 색을 또 손볼 때 고칠 자리가 하나다.

             <b>폴더와 파일을 가르는 것은 여기, 색이다.</b> 글리프는 어휘표대로 되돌렸고
             (FileItemViewModel.Glyph) 그 둘은 WPF 에서 비슷한 굵기의 윤곽선이라 형태만으로는
             약하다. 황토(폴더) 대 무채색(파일)이면 훑는 눈에 폴더가 먼저 걸린다 —
             목록에서 소수인 쪽이 튀어나오는 것이 맞다.

             기본값을 파일 쪽에 두고 폴더를 트리거로 덮는다. 반대로 두면 IsDirectory 가
             false 인 쪽에 트리거를 하나 더 달아야 한다. -->
        <Style x:Key="ItemGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Glyph}" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.FileGlyph}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.FolderGlyph}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 항목 앞 아이콘(Phase 11 · D68-c). 셸 아이콘(② 단)과 글리프(③ 단)를 같은 칸에
             겹쳐 두고, 셸 아이콘이 왔으면(ShellIcon 이 null 이 아니면) 그것만 보이게 가른다.
             ItemGlyph 스타일은 그대로 두고 이 템플릿 안에서 재사용한다 — 세 자리에 마크업을
             세 벌 만들지 않기 위해서다. -->
        <DataTemplate x:Key="ItemIcon">
            <Grid>
                <Image x:Name="ShellIconImage" Source="{Binding ShellIcon}" Width="16" Height="16"
                       VerticalAlignment="Center" Margin="0,0,5,0" />
                <TextBlock x:Name="GlyphText" Style="{StaticResource ItemGlyph}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShellIcon}" Value="{x:Null}">
                    <Setter TargetName="GlyphText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 정렬되는 컬럼 머리 (Phase 8-B 1).

             GridViewColumn 은 시각 트리 밖이라 DataContext 를 물려받지 않는다 — 그래서
             Header 에 바인딩을 걸 수 없다. HeaderTemplate 안은 다르다: 거기 그려지는 요소는
             GridViewColumnHeader 밑이고 그것은 ListView 의 자손이라, ListView 를 타고 올라가면
             패널 뷰모델에 닿는다. 컬럼마다 읽는 프로퍼티만 다르고 나머지는 같다.

             화살표는 지금 정렬 중인 컬럼에만 붙는다 — 붙이고 떼는 판정은 전부 뷰모델
             (HeaderTextFor)이 하고 여기서는 글자를 받아 그리기만 한다. 헤더 메타의 정렬
             글자와 같은 재료(SortLabel·SortArrow)에서 나오므로 둘이 어긋날 수 없다.

             누름은 여기가 아니라 ListView 의 GridViewColumnHeader.Click 하나가 받는다
             (아래 DetailsList). 어느 기준인지는 컬럼에 붙은 v:ColumnSort.SortKey 가 말한다. -->
        <DataTemplate x:Key="NameColumnHeader">
            <TextBlock Text="{Binding DataContext.NameHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>
        <DataTemplate x:Key="SizeColumnHeader">
            <TextBlock Text="{Binding DataContext.SizeHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>
        <DataTemplate x:Key="ModifiedColumnHeader">
            <TextBlock Text="{Binding DataContext.ModifiedHeaderText,
                              RelativeSource={RelativeSource AncestorType=ListView}}" />
        </DataTemplate>

        <!-- 평소 details 뷰. GridView 는 여러 ListView 가 나눠 쓸 수 없어(런타임 InvalidOperationException)
             x:Shared="False" 로 조회마다 새 인스턴스를 받는다 — 패널이 3개고 검색 시 뷰를 갈아타므로.

             폭은 여기 적은 것이 출발값이고, 표시된 컬럼 하나는 타일 폭에 맞춰 코드가 다시 쓴다
             (§3.2 · Stage 3D-2 — GridView 는 star 를 지원하지 않는다). 늘리는 것은 `이름` 하나다:
             `크기`·`수정` 은 내용이 고정적이라 늘릴 이유가 없다. 오른쪽에는 여백을 남긴다 —
             꽉 맞추면 단계 C 가 만든 고무줄 시작 자리가 사라진다(ColumnLayout.RightMargin). -->
        <GridView x:Key="NormalGridView" x:Shared="False">
            <!-- 머리 셋 다 눌러서 정렬한다 (Phase 8-B 1). 같은 컬럼을 다시 누르면 방향이
                 뒤집히는데, 그 규칙은 여기가 아니라 SetSortCommand 안에 이미 있던 것이다. -->
            <GridView.ColumnHeaderContainerStyle>
                <Style TargetType="GridViewColumnHeader"
                       BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="ToolTip"
                            Value="눌러서 이 열로 정렬 — 같은 열을 다시 누르면 오름/내림이 뒤집힌다" />
                    <!-- 컬럼 선택 메뉴 (Phase 15 · D79 · C-1) — 위 UserControl.Resources 참고. -->
                    <Setter Property="ContextMenu" Value="{StaticResource ColumnMenu}" />
                </Style>
            </GridView.ColumnHeaderContainerStyle>

            <GridViewColumn Header="이름" Width="260" v:ColumnLayout.IsFlexible="True"
                            HeaderTemplate="{StaticResource NameColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Name}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{StaticResource ItemIcon}" Content="{Binding}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="크기" Width="90"
                            HeaderTemplate="{StaticResource SizeColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Size}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="수정" Width="130" DisplayMemberBinding="{Binding ModifiedText}"
                            HeaderTemplate="{StaticResource ModifiedColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Modified}" />
        </GridView>

        <!-- 재귀 검색·전역 검색 중 details 뷰 — "위치" 열이 붙는다(탐색기 방식). 재귀 검색과
             검색 타일이 이 자원 하나를 나눠 쓴다(D69-e 결정 1과 같은 결 — 복제하지 않는다).
             여기서 늘리는 것은 `위치` 다 — 가장 긴 내용이 거기다(하위 폴더 상대 경로 또는
             검색 타일의 부모 폴더).

             이름·크기·수정에는 NormalGridView 와 똑같은 HeaderTemplate·SortKey 를 붙인다
             (D69-g) — 전역 검색 타일에서는 실제로 눌러서 정렬된다. 재귀 검색에서는
             OnColumnHeaderClick 의 IsRecursiveSearch 게이트가 누름을 막고,
             HeaderTextFor 가 같은 판정으로 화살표를 안 붙인다 — 같은 뷰가 검색 타일에서만
             정렬되므로 화살표를 다는 판정이 그 둘을 갈라야 한다(결정 4). -->
        <GridView x:Key="SearchGridView" x:Shared="False">
            <GridView.ColumnHeaderContainerStyle>
                <Style TargetType="GridViewColumnHeader"
                       BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="ToolTip"
                            Value="눌러서 이 열로 정렬 — 같은 열을 다시 누르면 오름/내림이 뒤집힌다" />
                    <!-- 컬럼 선택 메뉴 (Phase 15 · D79 · C-1) — 위 UserControl.Resources 참고. -->
                    <Setter Property="ContextMenu" Value="{StaticResource ColumnMenu}" />
                </Style>
            </GridView.ColumnHeaderContainerStyle>

            <GridViewColumn Header="이름" Width="220"
                            HeaderTemplate="{StaticResource NameColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Name}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <ContentControl ContentTemplate="{StaticResource ItemIcon}" Content="{Binding}" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <!-- 위치는 누를 수 없다(결정 2) — SortBy 열거자에 경로 값이 없다. HeaderTemplate·
                 SortKey 를 붙이지 않은 채 그대로 둔다. -->
            <GridViewColumn Header="위치" Width="180" v:ColumnLayout.IsFlexible="True">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding RelativeFolder}" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   ToolTip="{Binding FullPath}" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="크기" Width="80"
                            HeaderTemplate="{StaticResource SizeColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Size}">
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right"
                                   HorizontalAlignment="Right" />
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="수정" Width="120" DisplayMemberBinding="{Binding ModifiedText}"
                            HeaderTemplate="{StaticResource ModifiedColumnHeader}"
                            v:ColumnSort.SortKey="{x:Static models:SortBy.Modified}" />
        </GridView>
    </UserControl.Resources>

    <Grid>
        <!-- 상시 = 실선(호박), 순환 = 점선(보라). Border 는 점선을 못 그리므로 Rectangle 로 그린다. -->
        <!-- Fill 은 스타일에서만 준다. 로컬 값을 주면 스타일 트리거를 영구히 이겨 과녁의
             면 색이 켜지지 않는다 (MainWindow.xaml 대상함 항목과 같은 사고 — WPF 값 우선순위). -->
        <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="2">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Fill" Value="{StaticResource Brush.Surface}" />
                    <Setter Property="Stroke" Value="{StaticResource Brush.Pinned}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRotating}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Brush.Rotating}" />
                            <Setter Property="StrokeDashArray" Value="4 2.5" />
                        </DataTrigger>
                        <!-- 전역 검색 타일(D69-e) — 세 번째 색이자 세 번째 테두리 모양이다
                             (촘촘한 점선으로 순환 칸의 점선과도 갈린다). -->
                        <DataTrigger Binding="{Binding IsSearchTile}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Brush.Search}" />
                            <Setter Property="StrokeDashArray" Value="1 2" />
                        </DataTrigger>
                        <!-- 셸에서 끌어온 것이 이 타일 위에 있다 (§4.9). 폴더 행·대상함과 같은
                             파랑이라 "여기에 놓인다"가 같은 색으로 읽힌다. 상시/순환 강조보다
                             뒤에 둬서 이긴다 — 드래그 중에는 이쪽이 답이다. -->
                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Fill" Value="{StaticResource Brush.AccentSurface}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- 테두리만으로는 큰 타일에서 눈에 안 띄어 말로도 적는다 (§4.2-2 와 같은 글귀).
             글귀는 뷰모델이 만든다 — 놓으면 이동인지 복사인지를 말해야 하고(볼륨이 가른다)
             글자를 여기 박으면 받는 자리 셋이 세 벌이 되어 하나만 고쳐진다.
             목록 위에 떠야 하므로 형제 중 마지막이 아니라 여기 두고 Panel.ZIndex 로 올린다.
             IsHitTestVisible="False" — 이것이 없으면 깜빡인다. WPF 는 드래그 이벤트를 히트테스트로
             찾은 <b>자손</b>에 올리고 그것이 이 컨트롤까지 버블한다. 그래서 커서가 이 글귀 위로
             올라가면 아래 요소가 DragLeave 를 받고(→ IsDropTarget=false → 글귀가 사라짐) 다시
             DragOver(→ true → 글귀가 뜸)가 되어 제자리에서 진동한다. 과녁은 보이기만 하면 된다. -->
        <Border Panel.ZIndex="1" IsHitTestVisible="False"
                Background="{StaticResource Brush.AccentSurface}"
                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1.5"
                CornerRadius="3" Padding="10,4"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DropTargetText}" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Accent}" />
        </Border>

        <!-- 아직 아무 폴더도 안 띄운 순환 칸. 순환 칸이 여럿이면 제목이 번호를 밝힌다
             (예: "순환2 — 폴더를 지정하세요"). -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center"
                       Foreground="{StaticResource Brush.TextSecondary}" />
            <TextBlock Text="왼쪽 목록에서 폴더를 클릭" FontSize="11" TextAlignment="Center"
                       Margin="0,3,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- IsEmpty 의 반대로 보여야 하므로 로컬 Visibility 대신 Style 트리거를 쓴다
             (로컬 값이 있으면 트리거가 이기지 못한다). -->
        <DockPanel Margin="10,8">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>

            <!-- ── 헤더: breadcrumb + 뒤로/앞으로/상위/앵커 + 메타 + 검색 ── -->
            <StackPanel DockPanel.Dock="Top">
                <!-- DockPanel 이 아니라 Grid 다. DockPanel 은 남는 자리를 breadcrumb 에 주는데,
                     breadcrumb 은 줄어들 줄 모르고 그 위로 넘쳐 그려서 내비 아이콘을 덮었다.
                     Auto 열은 제 폭을 먼저 가져가므로 아이콘이 잘리지 않고, 대신 breadcrumb
                     쪽(* 열)이 잘린다 — 잘려도 되는 것은 그쪽이다. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 이름 자리는 최소한 남긴다 — 아이콘을 다 보여주려다 이름을 지우면 안 된다. -->
                        <ColumnDefinition Width="*" MinWidth="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 내비 클러스터 — 열 개에서 셋으로 줄었다(Phase 20 · D119).

                         D118 §7② JH 관측: 아이콘이 열 개일 때는 접힘 사다리(240/170)가
                         일하기도 전에 헤더 Grid 의 열 다툼(아래 앵커 c · App.xaml
                         SecondaryNavButton/TertiaryNavButton 주석)으로 오른쪽부터 짜부라들며
                         잘렸다 — ⤢(확장)가 맨 오른쪽이라 가장 먼저 죽었다. D116 이 「확장에
                         끝까지 안 접히는 자리를 준다」며 세운 전제가 무너진 것이다.

                         고치는 길은 접힘 단계를 손보는 것이 아니라 <b>아이콘 자체를 줄이는
                         것</b>이다(D119 A2 근거 — 일곱은 이미 대체 경로가 있다: 단축키·마우스
                         옆 버튼·컨텍스트 메뉴). 남는 셋(⌂·⤢·⋯)은 폭 합이 60px 대로 떨어져
                         열 다툼이 발동하는 폭 아래로 내려간다. 셋뿐이라 접을 이유가 없다 —
                         셋 다 스타일은 NavButton(비접힘)이다. 접으면 D116 이 겪은 것과 같은
                         문제("끝까지 남는 자리를 어느 아이콘에 줄까")가 다시 생긴다. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 앵커 복귀는 진입점이 셋(breadcrumb 첫 조각 · 왼쪽 리스트 재클릭 ·
                             Alt+Home, §4.6)이라 대체가 있지만, ⤢ 와 나란히 밖에 남기기로
                             D117~D119 가 정했다(다른 성격의 "장소"·"크기" 조작 둘을 늘 보이게). -->
                        <Button Style="{StaticResource NavButton}" Width="20"
                                Command="{Binding GoToAnchorCommand}"
                                AutomationProperties.Name="앵커로 복귀"
                                ToolTip="앵커로 복귀 (Alt+Home)" Content="⌂" />

                        <!-- 타일 확장 ↔ 복원 (Phase 19 · D116 · §4-7). 진입점이 이것 하나뿐이라
                             메뉴로 못 보낸다(D117 A2) — 대체 경로가 있는 것부터 메뉴로 보낸다는
                             원칙(D119 §2)에서 그대로 밖에 남는다. -->
                        <Button Style="{StaticResource NavButton}" Width="20"
                                Command="{Binding ToggleExpandCommand}"
                                CommandParameter="{Binding}"
                                Content="{Binding ExpandIcon}"
                                AutomationProperties.Name="타일 확장"
                                ToolTip="{Binding ExpandTip}" />

                        <!-- 더 보기 (Phase 20 · D119). 정렬 아이콘이 쓰던 방식을 그대로
                             따른다(D117 A5) — Button + 인라인 Button.ContextMenu + 클릭 시
                             OnMoreMenuClick 이 IsOpen 을 세운다. ContextMenu 는 시각 트리
                             밖이라 DataContext 가 안 내려온다 — Tag 로 패널 VM 을 잡는다
                             (정렬 메뉴와 같은 우회). Phase 13 의 ContextMenuOpening 가드는
                             이 아이콘 클러스터 자리에 안 걸린다(D117 A5 — 조상 사슬에
                             ContextMenu 가 없다) — 새 Popup 을 만들지 않고 저장소에 이미 있는
                             이디엄만 썼다. -->
                        <Button Style="{StaticResource NavButton}" Width="20"
                                Click="OnMoreMenuClick"
                                AutomationProperties.Name="더 보기"
                                ToolTip="더 보기" Content="⋯"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.ContextMenu>
                                <!-- 이동 → 보기 → 찾기, 구분선 둘로 세 묶음(D119 §4-4). -->
                                <ContextMenu>
                                    <MenuItem Header="뒤로" InputGestureText="Alt+←"
                                              Command="{Binding PlacementTarget.Tag.GoBackCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="앞으로" InputGestureText="Alt+→"
                                              Command="{Binding PlacementTarget.Tag.GoForwardCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="상위 폴더" InputGestureText="Alt+↑"
                                              IsEnabled="{Binding PlacementTarget.Tag.CanGoUp,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding PlacementTarget.Tag.GoUpCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="다시 읽기" InputGestureText="F5"
                                              Command="{Binding PlacementTarget.Tag.RefreshCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />

                                    <!-- 보기 방식 — 헤더 아이콘이 글리프(▦/☰)로 보여주던 상태를
                                         체크로 대신한다(D117 A3 손실 목록, D119 §4-4). 하위 메뉴
                                         둘로 갈라 지금 어느 쪽인지 체크가 늘 보이게 한다 —
                                         토글 하나로 두면 체크 없이는 지금 값을 알 길이 없다. -->
                                    <MenuItem Header="목록" IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.IsListView,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Mode=OneWay}"
                                              Command="{Binding PlacementTarget.Tag.SetViewModeCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:FolderViewMode.List}" />
                                    <MenuItem Header="자세히" IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.IsDetailsView,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Mode=OneWay}"
                                              Command="{Binding PlacementTarget.Tag.SetViewModeCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{x:Static models:FolderViewMode.Details}" />

                                    <!-- 미리보기 — 예전 헤더 아이콘(▤)은 상태를 안 보여줬다
                                         (D117 A3) — 체크가 붙는 것은 손실이 아니라 개선이다. -->
                                    <MenuItem Header="미리보기" IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.CurrentShowPreview,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Mode=OneWay}"
                                              Command="{Binding PlacementTarget.Tag.ToggleShowPreviewCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                    <!-- 정렬 — 예전 정렬 아이콘의 인라인 ContextMenu(다섯 항목:
                                         기준 넷 + 폴더 먼저)를 다시 짜지 않고 하위 메뉴로
                                         그대로 옮겼다(D119 §4-4). 재귀 검색 중에는 이 하위
                                         메뉴 전체를 잠근다 — 예전 정렬 아이콘의 IsEnabled 와
                                         같은 판정, 같은 이유(§4.10, 찾은 순서 그대로라 기준을
                                         바꿔도 순서가 안 바뀐다). -->
                                    <MenuItem Header="정렬"
                                              IsEnabled="{Binding PlacementTarget.Tag.IsRecursiveSearch,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Converter={StaticResource InverseBool}}">
                                        <MenuItem Header="이름"
                                                  Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static models:SortBy.Name}" />
                                        <MenuItem Header="수정"
                                                  Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static models:SortBy.Modified}" />
                                        <MenuItem Header="크기"
                                                  Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static models:SortBy.Size}" />
                                        <MenuItem Header="종류"
                                                  Command="{Binding PlacementTarget.Tag.SetSortCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{x:Static models:SortBy.Type}" />
                                        <Separator />
                                        <!-- 폴더 먼저 끄기 = 통합 정렬 (Phase 8-B ②). 검색
                                             타일은 이 토글이 뜻이 없다 — ToggleFoldersFirstAsync
                                             가 Entry 를 써서 아무 일도 안 한다(D69-f 결정 6).
                                             죽은 손잡이를 보이는 채로 두지 않는다. 이미 메뉴
                                             안에 있었으므로 옮겨도 잃는 것이 없다(D117 A2-8b). -->
                                        <MenuItem Header="폴더 먼저" IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.Tag.FoldersFirst,
                                                              RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                              Mode=OneWay}"
                                                  Command="{Binding PlacementTarget.Tag.ToggleFoldersFirstCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding PlacementTarget.Tag.IsSearchTile,
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                               Converter={StaticResource InverseBoolToVisibility}}"
                                                  ToolTip="끄면 폴더와 파일을 한 덩어리로 정렬한다 — 아이콘에 ∪ 가 붙는다 (창을 다시 열면 켜진 상태로 돌아온다)" />
                                    </MenuItem>
                                    <Separator />

                                    <!-- 검색 — 예전 배경 강조(NavToggleButton) 대신 체크가 상태를
                                         보여준다. ToggleSearchExpandedCommand 는 예전 헤더 🔍
                                         아이콘의 OnSearchToggleClick 과 같은 판정을 커맨드로
                                         올린 것이다(D119 §4-2) — 포커스를 주는 것은 뷰의 일이라
                                         Ctrl+F 경로(FocusSearch)만 그대로 한다. -->
                                    <MenuItem Header="검색" InputGestureText="Ctrl+F" IsCheckable="True"
                                              IsChecked="{Binding PlacementTarget.Tag.IsSearchExpanded,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                          Mode=OneWay}"
                                              Command="{Binding PlacementTarget.Tag.ToggleSearchExpandedCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 폴더 이름 줄 = breadcrumb + 개수 (Phase 8-C ③).

                         개수가 2줄째에서 여기로 올라왔다. <b>개수를 오른쪽에 도킹하고
                         breadcrumb 이 남는 자리를 먹는다</b> — 반대로 두면(개수가 이름 바로 뒤)
                         경로가 길어질 때 개수가 먼저 잘려 나간다. 잘려도 되는 것은 경로 쪽이고
                         (그쪽은 툴팁·앵커 복귀로 되찾을 수 있다) 개수는 늘 보여야 한다.
                         Auto 열을 새로 만들지 않은 이유도 같다: 열을 만들면 개수가 이름 칸의
                         MinWidth 를 밀어 내비 아이콘이 잘리는 옛 사고로 돌아간다. -->
                    <DockPanel Grid.Column="0">
                        <!-- 개수 + 선택 (Phase 8-C ③ · 8-D ①).

                             선택 조각이 2줄째에서 여기로 붙었다. 저쪽은 <b>있다 없다 하는 줄</b>
                             이라 고르는 순간 헤더가 한 줄 자라고 풀면 줄었다 — 목록을 고르는
                             손 아래에서 목록이 뛰었다. 이 줄은 늘 있으므로 글자만 길어진다.
                             굵기만 바꾸는 것은 줄 높이를 건드리지 않는다(글자 크기가 같다).

                             Run 사이에 줄바꿈을 두지 않는다: TextBlock 안에서 요소 사이의
                             공백은 공백 한 칸으로 살아남아 점 앞이 벌어진다. 그래서 /><Run 이
                             붙어 있고, 구분점은 SelectionSuffix 가 들고 온다. -->
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="6,0,4,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   ToolTip="{Binding MetaText}"><Run
                                       Text="{Binding ItemCountText, Mode=OneWay}" /><Run
                                       Text="{Binding SelectionSuffix, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent}" /></TextBlock>

                    <!-- breadcrumb: 첫 조각(앵커) 클릭 = 앵커 복귀. 우클릭 = 「지금 보고 있는
                         폴더」 메뉴(§4.6 · D75) — 목록의 빈 곳과 같은 메뉴다(D75-c-4).
                         Background="Transparent" 가 없으면 글자가 없는 자리(검색 타일에서
                         Breadcrumbs 가 비었을 때 등)는 히트테스트에 안 걸린다(B-0 §B.4 가
                         [추측]으로 남겨 둔 것을 D75-c 가 실제로 확인하고 고쳤다).
                         ContextMenuOpening 은 ListArea 와 같은 핸들러다(D75-d) — 검색 타일
                         가드가 여기도 필요해서다.

                         오른쪽 우선 잘림(Phase 20 · D118 · W1) — 현재 폴더 이름이 먼저
                         잘리던 것을 고친다(D117 A6). ItemsControl 에 HorizontalAlignment
                         만 주는 안(가)은 실측으로 기각했다: ItemsControl 자신의 DesiredSize
                         가 이미 슬롯 폭으로 눌린 채 계산되므로(기본 Template 이 폭을 무한대로
                         재지 않는다) alignment 오프셋이 0 이 되어 Left·Right·Stretch 가
                         똑같이 움직인다 — 왼쪽으로 넘치지 않는다. 그래서 (나) 로 간다:
                         ScrollViewer 로 감싸고 코드 비하인드가 오른쪽 끝으로 미는 것 — 항목
                         폭 합이 슬롯보다 넓으면 왼쪽(앞쪽 조각)이 스크롤 밖으로 밀려나고
                         오른쪽(현재 폴더)이 항상 보인다. Background·ToolTip·ContextMenu 가
                         ItemsControl 에서 여기(ScrollViewer)로 옮겨온 이유는 같다 —
                         내용보다 넓은 빈 자리의 히트테스트를 이 바깥 껍데기가 챙겨야
                         해서다. -->
                    <ScrollViewer x:Name="BreadcrumbScroll"
                                  VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent"
                                  ToolTip="우클릭: 지금 보고 있는 폴더 메뉴"
                                  ContextMenu="{StaticResource CurrentFolderMenu}"
                                  ContextMenuOpening="OnListContextMenuOpening"
                                  ScrollChanged="OnBreadcrumbScrollChanged">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}"
                                      VerticalAlignment="Center" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="›" Foreground="{StaticResource Brush.TextSecondary}"
                                                   Margin="1,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Style="{StaticResource LinkButton}"
                                                Content="{Binding Name}"
                                                ToolTip="{Binding Path}"
                                                Command="{Binding DataContext.NavigateToCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Path}">
                                            <Button.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAnchor}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- 2줄 = <b>지금 벌어지고 있는 일</b>만 (Phase 8-C ③).

                     개수·뷰 방식·정렬은 1줄로 올라갔다. 여기 남은 셋(앵커 밖 · 선택 · 읽는 중)은
                     평소에 하나도 없으므로 그때는 줄을 통째로 접어 헤더 높이를 돌려준다 —
                     1x1 타일에서 이 한 줄이 목록 두 행쯤 된다.

                     Visibility 를 로컬 값으로 준다(스타일 트리거가 아니라): 이 줄에는 IsEmpty
                     같은 반대 조건이 겹치지 않아 하나로 충분하다.
                     좁은 타일에서 넘치지 않게 잘라 낸다. -->
                <StackPanel Orientation="Horizontal" Margin="3,2,0,4" ClipToBounds="True"
                            Visibility="{Binding HasStatusLine,
                                         Converter={StaticResource BoolToVisibility}}">
                    <!-- 앞의 "·" 를 뗐다 (Phase 8-C ③): 개수·뷰·정렬이 1줄로 올라가면서
                         이 글귀가 줄의 첫 조각이 됐다 — 앞 조각이 없는데 구분점만 남으면
                         무엇에서 이어지는지 알 수 없는 점 하나가 뜬다. -->
                    <TextBlock Text="앵커 밖" Foreground="{StaticResource Brush.Rotating}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsAwayFromAnchor,
                                                    Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="읽는 중…" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- 검색 줄 — 헤더 안이 아니라 헤더 "아래"에 한 줄로 펴진다.
                     헤더 안에서 좌우로 펴면 breadcrumb 길이에 따라 폭이 널뛴다.
                     기준점은 지금 보고 있는 폴더(currentPath). 이름 부분일치만.
                     되접힘은 컨테이너의 IsKeyboardFocusWithin 으로 본다 —
                     "하위 포함"이나 ✕ 로 포커스가 옮겨가도 접히지 않게. -->
                <DockPanel x:Name="SearchArea" Margin="0,2,0,6"
                           IsKeyboardFocusWithinChanged="OnSearchFocusWithinChanged"
                           Visibility="{Binding IsSearchExpanded,
                                        Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                            Command="{Binding CloseSearchCommand}"
                            AutomationProperties.Name="검색 닫기"
                            ToolTip="검색 닫기" Content="✕" />
                    <!-- 전역 검색 타일은 이 토글이 뜻이 없다 — Everything 이 이미 전체를
                         본다(D69-e 6-2). -->
                    <CheckBox DockPanel.Dock="Right" Content="하위 포함" VerticalAlignment="Center"
                              Margin="8,0,4,0" FontSize="11"
                              IsChecked="{Binding IncludeSubfolders}"
                              Visibility="{Binding IsSearchTile, Converter={StaticResource InverseBoolToVisibility}}"
                              ToolTip="켜면 이 폴더 아래 트리를 재귀로 검색한다" />
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="4,3" FontSize="12" MinHeight="24"
                             VerticalContentAlignment="Center"
                             ToolTip="이름으로 검색 (대소문자 무시 · 부분일치)" />
                </DockPanel>
            </StackPanel>

            <!-- ── 접근 불가: 폴더를 목록에서 지우지 않고 상태 + 다시 시도 (§5) ── -->
            <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,6" CornerRadius="3"
                    Background="{StaticResource Brush.DangerSurface}"
                    Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding FailureText}" Foreground="{StaticResource Brush.Danger}"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentPath}" Foreground="{StaticResource Brush.TextSecondary}"
                               FontSize="11" Margin="0,3" TextWrapping="Wrap" />
                    <Button Content="다시 시도" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Left" Padding="10,3" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- 검색 진행 / 건너뜀 / 결과 없음 -->
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding SearchStatusText}" FontSize="11" Margin="3,4,0,0"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                <!-- 권한 없음·끊긴 네트워크로 못 본 하위가 있으면 한 줄로 알린다 (§5). -->
                <TextBlock Text="{Binding SkippedFoldersText}" FontSize="11" Margin="3,4,0,0"
                           Foreground="{StaticResource Brush.Danger}"
                           Visibility="{Binding HasSkippedFolders,
                                                Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- ListArea — 고무줄의 유일한 좌표계다 (§4.2-2 · Stage 3B). 사각형도 항목 사각형도
                 이 요소 기준으로만 잰다. 두 좌표계를 섞으면 스크롤된 목록에서 어긋난다.

                 「지금 보고 있는 폴더」 메뉴(§4.6 · D75)도 여기 하나에 붙인다 — 아래
                 DetailsList·SimpleList 어느 쪽이 보이든(Background="Transparent" 라 둘 다
                 빈 곳까지 히트테스트된다) ContextMenu 탐색이 이 Grid 까지 거슬러 올라와 열린다.
                 항목(ListViewItem) 위에서는 열리면 안 된다 — OnListContextMenuOpening 이
                 RubberBand.Classify(B-0 §A.1 · 고무줄과 같은 판정)로 걸러 그 자리에서는
                 e.Handled = true 로 취소한다. 새 히트테스트를 만들지 않는다(D75-c).
                 검색 타일 위에서도 같은 핸들러가 취소한다(D75-d) — 근거는 코드비하인드의
                 OnListContextMenuOpening 주석에 있다. 컬럼 머리 위에서는 취소하지 않는다
                 (Phase 15 · D79) — 거기는 컬럼 자신의 메뉴(컬럼 선택, 위 GridView 의
                 ColumnHeaderContainerStyle)가 대신 연다.

                 예전에는 "빈 곳(배경) 메뉴를 새로 만들지 않는다 — 고무줄 선택이 그 자리를
                 쓴다"고 여기 적어 두었었다. 그 근거는 틀렸다 — 고무줄은 좌클릭 드래그고 이
                 메뉴는 우클릭이라 애초에 자리를 다투지 않는다. design.md §4.6 「지금 보고
                 있는 폴더」 메뉴(D75) 절이 이 뒤집음의 근거를 갖는다. -->
            <Grid x:Name="ListAndPreview">
                <!-- ListArea 와 미리보기 칸을 함께 담는 바깥 Grid (Phase 17 · D86 · §3.2).

                     DockPanel 은 Dock 없는 「마지막 자식」에게 남은 자리를 준다 — 그 자리를
                     ListArea 가 혼자 쓰고 있었다. 미리보기 칸을 형제로 나란히 두면 Dock 을
                     줘야 하고 그러면 위의 검색 상태 줄과 자리를 다툰다. 그래서 둘을 이 Grid 로
                     묶고 이 Grid 가 마지막 자식이 된다.

                     행 셋 — 목록(*) · 스플리터(Auto) · 미리보기(*). 저장되는 값은 비율 하나이고
                     (§7.1 v9 previewRatio) 두 별 가중치가 그것을 나눠 갖는다. 꺼져 있을 때는
                     코드비하인드가 아래 둘을 Collapsed 로 두고 PreviewRow 를 0 으로 눌러
                     ListArea 가 예전과 똑같이 전부를 쓴다 — 기본이 꺼짐이므로 이 회차 전과
                     화면이 같아야 한다.

                     MinHeight 96/120 은 「정한 값」이다(고무줄 여백 32px 과 같은 종류).
                     목록 한 줄이 약 23px 이고 상세 뷰는 컬럼 머리글이 위를 먹으므로 96px 이
                     대략 「머리글 + 세 줄」이다. 미리보기는 38px 에서 xlsx 가 시트 탭 줄만
                     남았다(D85 실측). 비율만으로는 목록이 한 줄도 안 남는 자리를 못 막는다. -->
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ListRow" Height="*" />
                    <RowDefinition x:Name="SplitterRow" Height="Auto" />
                    <RowDefinition x:Name="PreviewRow" Height="0" />
                </Grid.RowDefinitions>

            <Grid x:Name="ListArea" Grid.Row="0" ContextMenu="{StaticResource CurrentFolderMenu}"
                  ContextMenuOpening="OnListContextMenuOpening">
                <!-- "검색 안 함"(평소 빈 폴더)과 구분되는 "결과 없음" -->
                <TextBlock Text="결과 없음" Foreground="{StaticResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibility}}" />

                <!-- 전역 검색이 정상이 아닐 때의 안내(D69-e 결정 7) — 검색하지 않고 이유를
                     적는다. EverythingStatus.Describe() 와 같은 말이라 설정 창과 어긋나지
                     않는다. -->
                <TextBlock Text="{Binding EverythingStatusText}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextAlignment="Center" Margin="20,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasEverythingStatusText, Converter={StaticResource BoolToVisibility}}" />

                <!-- ── 파일 목록 · 가상화 켬 (§8 — 로그 수천 개 폴더에서 UI 멈춤 방지) ──
                     View 는 Style 로만 정한다(로컬 값을 주면 검색 시 열 교체 트리거가 이기지 못한다). -->
                <ListView x:Name="DetailsList" ItemsSource="{Binding DisplayItems}"
                          GridViewColumnHeader.Click="OnColumnHeaderClick"
                          ItemContainerStyle="{StaticResource FileItemContainer}"
                          BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                          ScrollViewer.ScrollChanged="OnDetailsScrollChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Setter Property="View" Value="{StaticResource NormalGridView}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- 재귀 검색·전역 검색 중에는 "위치" 열이 붙은 뷰로 갈아탄다
                                     (D69-e — NeedsLocationColumn 이 둘을 함께 가른다). -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsDetailsView}" Value="True" />
                                        <Condition Binding="{Binding NeedsLocationColumn}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="View" Value="{StaticResource SearchGridView}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                </ListView>

                <ListView x:Name="SimpleList" ItemsSource="{Binding DisplayItems}"
                          ItemContainerStyle="{StaticResource FileItemContainer}"
                          BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended"
                          SelectionChanged="OnSelectionChanged"
                          PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource ItemIcon}" Content="{Binding}" />
                                <!-- list 뷰의 검색 결과는 이름 앞에 상대 폴더를 흐리게 붙인다. -->
                                <TextBlock Text="{Binding RelativeFolderPrefix}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Visibility="{Binding HasRelativeFolder,
                                                                Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 고무줄 사각형 (§4.2-2 · Stage 3B). 과녁 강조와 같은 토큰이라 "이 앱이 지금
                     무엇을 집고 있다"가 같은 파랑으로 읽힌다.
                     IsHitTestVisible="False" — 이것이 없으면 사각형이 자기 밑의 항목을 가려
                     판정이 자기 그림에 걸린다(Stage 1 의 과녁 강조 진동과 같은 사고).
                     ClipToBounds="True" — 캡처 중에는 커서가 목록 밖으로 나가므로 사각형이
                     목록 영역을 넘어 그려지지 않게 잘라 준다. -->
                <Canvas x:Name="BandLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="Band" Visibility="Collapsed"
                               Stroke="{StaticResource Brush.Accent}" StrokeThickness="1"
                               Fill="{StaticResource Brush.AccentSurface}" />
                </Canvas>
            </Grid>

                <!-- 목록 ↔ 미리보기 경계 (Phase 17 · D86). RowSplitter 스타일은 이미 있는 것을
                     그대로 쓴다 — 새 모양을 만들지 않는다. 끌기가 끝날 때만 비율을 저장한다
                     (끄는 동안 저장하면 워크스페이스가 픽셀마다 써진다). -->
                <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Height="6"
                              Style="{StaticResource RowSplitter}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Visibility="Collapsed"
                              DragCompleted="OnPreviewSplitterDragCompleted" />

                <!-- 미리보기 칸 — 회차 2b-1 이 ② 단(셸 썸네일)과 ③ 단(글귀)을 넣는다.

                     둘을 겹쳐 두고 코드비하인드가 하나만 보이게 한다 — 새 컨버터를 만들지
                     않는다. 이 칸은 늘 한 파일만 그리므로 상태가 둘뿐이고, 컨버터를 만들면
                     같은 판정이 XAML 과 코드비하인드 두 자리에 산다.

                     StretchDirection 을 걸지 않는다 — 확대를 허용한다(D95-b). 손 확인에서
                     dwg 가 그렇게 나왔다: AutoCAD 가 도면에 심어 둔 미리보기가 작은 고정
                     크기라, 늘리지 않으면 큰 칸에서도 우표만 하게 남는다. 이 칸의 쓰임은
                     「이게 그 도면 맞나」를 가리는 것이고, 그 판단에는 뭉개져도 큰 쪽이 낫다.
                     회차 2b-1 은 반대로 적어 두었었다 — 손 확인이 그 근거를 뒤집었다. -->
                <Border x:Name="PreviewPane" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- ① 단 — IPreviewHandler 를 얹는 네이티브 창(Phase 17 · D103).
                             네이티브 창은 WPF 가 그린 것 위에 덮어 그린다. 그래서 ② 단·③ 단으로
                             내려앉을 때는 반드시 Collapsed 로 돌려야 한다 — 안 그러면 밑의
                             그림이 안 보인다. -->
                        <interop:PreviewHandlerHost x:Name="PreviewHost" Visibility="Collapsed" />
                        <Image x:Name="PreviewImage" Visibility="Collapsed" Margin="8"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="PreviewFallbackText" Text="미리 볼 수 없습니다" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- 활성 링 — "지금 키보드가 이 타일에 있다" (Phase 5 「타일 포커스」 C-2).
             C-1 이 여백 다운으로 이 패널에 포커스를 주게 됐으니, 어느 타일이 그것을 가졌는지가
             화면에 보여야 한다.

             <b>기존 테두리 Rectangle(:243)을 건드리지 않는다.</b> 그 하나가 이미 면·상시/순환
             성격·드롭 과녁 셋을 Stroke/Fill 로 들고 있어서, 넷째를 얹으면 같은 속성을 두고
             트리거 우선순위를 다툰다(:241~242 주석과 같은 사고). 그래서 별 요소로 얹는다.

             Fill 을 주지 않는다 — 면은 기존 Rectangle 것이고 이것은 테두리만이다.
             IsHitTestVisible="False" — 이것이 클릭을 먹으면 C-1 이 무너진다(이 요소가 다운을
             가져가면 그 아래 목록·버튼이 못 받는다).

             Margin="4" 은 기존 테두리와 <b>2px 를 띄우려고</b> 고른 값이다: 기존 것이 타일
             가장자리 0~2px 를 쓰므로 Margin="2" 면 이 링이 곧바로 2~4px 를 이어 받아 두 겹이
             4px 한 줄로 붙어 보인다. 4 로 들이면 2(테두리)-2(빈틈)-2(링) 가 되어 갈린다.
             RadiusX/Y 는 기존 4 보다 작은 2 다 — 모서리 곡률까지 달라야 두 겹이 더 갈린다.

             Visibility 는 로컬 값이 아니라 Style 로 준다. 로컬 값을 주면 트리거가 이기지 못한다
             (:291~292 가 같은 이유로 같은 방법을 쓴다). 판정은 뷰의 IsKeyboardFocusWithin 을
             직접 읽는다 — 뷰모델에 새 활성 상태를 만들지 않는다(판정이 이미 SelectionOwner(선택)
             와 IsKeyboardFocusWithin(포커스) 둘로 갈라져 있어 셋째를 만들지 않는다).
             새 컨버터를 만들지 않는다 — DataTrigger 가 bool 을 그대로 본다. -->
        <Rectangle Margin="4" RadiusX="2" RadiusY="2" IsHitTestVisible="False"
                   Stroke="{StaticResource Brush.TileActive}" StrokeThickness="2">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin,
                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
    </Grid>
</UserControl>
