<Window x:Class="FolderDeck.App.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">


    <StackPanel Margin="18,14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextSecondary}" />

        <TextBox x:Name="NameBox" Padding="5,4" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">

            <Button x:Name="AcceptButton" Padding="16,5" Margin="0,0,8,0" IsDefault="True"
                    Click="OnAccept" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
