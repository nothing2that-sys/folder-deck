<Window x:Class="FolderDeck.App.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="같은 이름이 있다"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        동일 이름 충돌 (§4.3). 겹치는 것이 있을 때만 뜬다.

        버튼 글씨가 곧 동작이다 — "예/아니오"로 물으면 무엇이 예인지 매번 다시 읽어야 한다.
        기본 단추(Enter)는 부르는 쪽이 넘긴 현재 정책에 맞춘다.
    -->
    <StackPanel Margin="18,16">
        <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14" />

        <!-- 켜면 그 선택이 워크스페이스에 저장되고 다음부터 조용히 그 정책으로 간다.
             되돌리는 자리는 대상함 탭에 있다. -->
        <CheckBox x:Name="RememberBox" Margin="0,0,0,16"
                  Content="이 작업 관리에서는 다음부터 묻지 않기" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OverwriteButton" Content="덮어쓰기" Padding="14,5" Margin="0,0,6,0"
                    Click="OnOverwrite"
                    ToolTip="기존 파일을 새 것으로 바꾼다" />
            <Button x:Name="SkipButton" Content="건너뛰기" Padding="14,5" Margin="0,0,6,0"
                    Click="OnSkip"
                    ToolTip="같은 이름은 손대지 않고 넘어간다 (결과에 '건너뜀'으로 잡힌다)" />
            <Button x:Name="RenameButton" Content="둘 다 두기" Padding="14,5" Margin="0,0,12,0"
                    Click="OnRename"
                    ToolTip="a.txt 옆에 a (2).txt 로 넣어 둘 다 남긴다" />
            <Button Content="취소" Padding="14,5" IsCancel="True"
                    ToolTip="아무것도 하지 않는다" />
        </StackPanel>
    </StackPanel>
</Window>
