<Window x:Class="FolderDeck.App.Views.ContentDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="내용 비교"
        Width="900" Height="600"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        내용 비교(기능 후보 ①의 연장, 2026-09-18, doc/FeatureCandidates_2026-09-18_design.md
        §①). 타일 비교가 [다름]으로 표시한 행을 우클릭 → "내용 비교"로 여기까지 온다.

        비모달이다(DuplicateFinderWindow 와 같은 이유 — Show(), ShowDialog() 아님) — 보면서
        타일도 계속 써야 한다. diff 계산은 전부 순수 함수(FolderDeck.Core.Comparison.
        FileContentDiffer, DiffPlex 를 감싼다)가 하고, 이 창은 결과(Left/Right, 이미 같은
        길이로 정렬됨)를 나란히 그리기만 한다.

        나란히(사이드바이사이드) 표시로 정했다(2026-09-18 대화) — WinMerge 스타일 2단, 왼쪽=
        우클릭한 항목이 있는 타일, 오른쪽=비교 상대 타일.

        바뀐(Modified) 줄은 줄 전체를 노랗게 칠하지 않는다(2026-09-21 JH 지적 — "노란색으로만
        표시되면 뭐가 다른지 확인이 안 된다") — DiffPlex 의 단어 단위 하위 diff(SubPieces)를
        받아 실제로 바뀐 단어 토막만 노랗게 칠한다(FolderDeck.Core.Comparison.ContentDiffSpan,
        ContentDiffWindow.xaml.cs 의 SpansFor). 완전히 지워지거나(Deleted)/생긴(Inserted) 줄은
        토막을 안 나누고 줄 전체를 칠한다 — 그 둘은 줄 전체가 그 뜻이다.
    -->
    <DockPanel Margin="14">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Margin="0,0,0,8"
                   TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LeftHeaderText" Grid.Column="0" FontWeight="SemiBold" />
            <TextBlock x:Name="RightHeaderText" Grid.Column="2" FontWeight="SemiBold" />
        </Grid>

        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <ListView x:Name="RowList" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{Binding LeftLineBackground}">
                                <DockPanel Margin="4,1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding LeftNumber}"
                                               Width="40" TextAlignment="Right" Margin="0,0,8,0"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding LeftSpans}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Background="{Binding Background}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{Binding RightLineBackground}">
                                <DockPanel Margin="4,1">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding RightNumber}"
                                               Width="40" TextAlignment="Right" Margin="0,0,8,0"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                    <ItemsControl ItemsSource="{Binding RightSpans}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Background="{Binding Background}"
                                                           FontFamily="Consolas" FontSize="12"
                                                           TextWrapping="NoWrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </DockPanel>
</Window>
