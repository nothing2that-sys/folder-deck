<Window x:Class="FolderDeck.App.Views.PickOneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        여럿 중 하나를 글자 목록으로 고르는 범용 창(2026-09-18, 기능 후보 ① 타일 비교가
        첫 소비자). RenameDialog 와 같은 이유의 작은 전용 창이다 — 목록에서 하나를 고르는
        것은 MessageBox 로 안 된다. IUserPrompt 뒤에 있어 ViewModels 층은 이 창을 모른다.
    -->
    <StackPanel Margin="18,14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextSecondary}" />

        <ListBox x:Name="OptionList" Margin="0,10,0,0" MaxHeight="220"
                 MouseDoubleClick="OnListDoubleClick" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="AcceptButton" Content="고르기" Padding="16,5" Margin="0,0,8,0"
                    IsDefault="True" Click="OnAccept" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
