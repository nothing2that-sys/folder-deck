<UserControl x:Class="FolderDeck.App.Views.TileGridView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FolderDeck.App.Views"
             xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!--
        오른쪽 4x4 그리드 (§3.2 · Phase 2).

        세 층을 정확히 겹쳐 둔다 — 셀 층(격자·빈 칸 과녁) / 타일 층 / 드래그 미리보기.
        세 층 모두 같은 4x4 Grid 라서 픽셀 ↔ 셀 환산이 Host 크기 하나로 끝난다.
        격자 크기는 §3.2 가 4x4 로 못박은 값이며 Core 의 GridLayout 도 4x4 로 정규화한다.
    -->
    <Grid x:Name="Host" Focusable="True" ClipToBounds="True"
          MouseMove="OnHostMouseMove"
          MouseLeftButtonUp="OnHostMouseUp"
          LostMouseCapture="OnHostLostCapture"
          KeyDown="OnHostKeyDown">

        <!-- ── 1층: 셀 경계 + 빈 칸 (배치 편집 모드 중 · 아무 타일도 확장 중이 아닐 때만) ──
             Phase 19 · D116 · §4-4 — 확장 중에는 배치 편집 자체가 막히지만(§4-5), 그 전환
             순간에 빈 칸이 잠깐 비쳐 보이는 것도 막는다. 새 컨버터를 만들지 않고
             MultiDataTrigger 로 두 조건을 겹친다(App.xaml 의 RowActionButton 이 쓰는
             MultiDataTrigger 와 같은 이디엄). 칸마다 깃발을 두지 않는다 — 층 하나에
             트리거 하나다. -->
        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEditingLayout}" Value="True" />
                                <Condition Binding="{Binding IsAnyTileExpanded}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Column" Value="{Binding X}" />
                    <Setter Property="Grid.Row" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GridCellViewModel}">
                    <!-- 빈 칸만 클릭·드롭을 받는다. 타일이 덮은 칸은 위층 타일이 가져간다.
                         여백은 아래 넷이 같은 값 하나를 읽는다 — 어긋나면 드래그 미리보기가
                         실제 타일과 다른 자리에 그려진다. ItemTemplate 안이라 DataContext 가
                         칸 뷰모델이므로 ElementName 으로 Root 를 거친다(아래 폴더 선택 팝업과
                         같은 우회다). -->
                    <Border CornerRadius="3" BorderThickness="1"
                            Margin="{Binding DataContext.TileGap, ElementName=Root,
                                     Converter={StaticResource TileMargin}}"
                            Background="Transparent"
                            AllowDrop="True"
                            DragOver="OnCellDragOver"
                            DragLeave="OnCellDragLeave"
                            Drop="OnCellDrop"
                            MouseLeftButtonUp="OnCellClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.GridLine}" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFree}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Setter Property="Background"
                                                Value="{StaticResource Brush.GridCellSurface}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip"
                                                Value="클릭해서 폴더를 넣거나, 왼쪽 목록에서 폴더를 끌어다 놓는다" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                        <Setter Property="Background"
                                                Value="{StaticResource Brush.AccentSurface}" />
                                        <Setter Property="BorderBrush"
                                                Value="{StaticResource Brush.Accent}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="＋" FontSize="16" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   Visibility="{Binding IsFree, Converter={StaticResource BoolToVisibility}}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── 2층: 타일 ── -->
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <!-- Phase 19 · D116 · §4-4 — 확장 중인 타일은 EffectiveCellX 등이 0/0/격자
                     전체를 내고, 나머지는 저장값을 그대로 낸다(TileViewModel 의 파생 속성).
                     확장이 아무 데도 없으면 이 넷은 CellX 등과 값이 같다. -->
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Column" Value="{Binding EffectiveCellX}" />
                    <Setter Property="Grid.Row" Value="{Binding EffectiveCellY}" />
                    <Setter Property="Grid.ColumnSpan" Value="{Binding EffectiveSpanX}" />
                    <Setter Property="Grid.RowSpan" Value="{Binding EffectiveSpanY}" />
                    <!-- 다른 타일이 확장 중이면 이 타일은 접힌다 — 안 접으면 PreviewHandlerHost
                         (네이티브 자식 창)가 WPF Z 순서를 안 지키고 확장된 타일 위로 뚫고
                         나온다(D114 A7). -->
                    <Setter Property="Visibility"
                            Value="{Binding IsHiddenByExpansion, Converter={StaticResource InverseBoolToVisibility}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TileViewModel}">
                    <Grid x:Name="TileRoot">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- 잡고 끄는 동안 원래 자리는 흐려진다 — 미리보기가 주인공. -->
                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 파일 목록. 편집 모드에서는 상호작용을 잠근다(실수 클릭 방지).
                             여백은 여기서 준다 — 격자의 밀도는 격자가 아는 것이고 파일 목록
                             패널이 알 일이 아니다(그래서 FolderPanelView.xaml 루트에는 값이 없다). -->
                        <views:FolderPanelView DataContext="{Binding Panel}"
                                               Margin="{Binding DataContext.TileGap,
                                                        ElementName=Root,
                                                        Converter={StaticResource TileMargin}}"
                                               IsHitTestVisible="{Binding DataContext.IsViewMode,
                                                                  ElementName=TileRoot}" />

                        <!-- 편집 손잡이 층 — 여기를 잡으면 이동, 오른쪽 아래 그립은 리사이즈. -->
                        <Border Background="{StaticResource Brush.EditOverlay}"
                                CornerRadius="4" Cursor="SizeAll"
                                Tag="{Binding}"
                                Margin="{Binding DataContext.TileGap, ElementName=Root,
                                         Converter={StaticResource TileMargin}}"
                                MouseLeftButtonDown="OnTileMouseDown"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <!-- ContextMenu 는 시각 트리 밖이라 DataContext 가 안 내려온다 —
                                 Tag 로 타일 뷰모델을 잡는다(FolderPanelView.xaml 의 정렬 메뉴와
                                 같은 우회). 검색 타일은 「상시 ↔ 순환 바꾸기」가 뜻이 없다
                                 (§2.3 · D69-e 6-3) — 목록에서 지우지 않고 접는다. -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="상시 ↔ 순환 바꾸기" Click="OnToggleKindClick"
                                              Visibility="{Binding PlacementTarget.Tag.IsSearch,
                                                           RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                           Converter={StaticResource InverseBoolToVisibility}}" />
                                    <MenuItem Header="이 타일 빼기 (폴더 등록은 남는다)"
                                              Click="OnRemoveTileClick" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid Margin="6">
                                <!-- 이름표: 상시 = 실선 칩, 순환 = 점선 칩 (§3.2 색맹 대비) -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                        CornerRadius="3" Padding="6,2" BorderThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource Brush.PinnedSurface}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource Brush.Pinned}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRotating}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.RotatingSurface}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Brush.Rotating}" />
                                                </DataTrigger>
                                                <!-- 검색 칩의 세 번째 모양(D69-e 6-3) — 색만이
                                                     아니라 왼쪽 글리프도 🔍 로 바뀐다(아래
                                                     TextBlock.Style) — 색맹 대비. -->
                                                <DataTrigger Binding="{Binding IsSearch}" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.SearchSurface}" />
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Brush.Search}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⠿" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSearch}" Value="True">
                                                            <Setter Property="Text" Value="🔍" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding EditLabel}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeText}" Margin="6,0,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Text="끌어서 이동 · 모서리로 크기 · 우클릭으로 성격/제거" />

                                <!-- 리사이즈 그립 — 오른쪽 아래 모서리.
                                     보이는 크기(18)는 그대로 두고 <b>잡히는 영역만</b> 키운다:
                                     투명한 36x36 이 모서리를 덮고 마우스를 받는다. 작은 그립을
                                     정확히 겨냥해야 하는 답답함이 없어진다. 음수 여백으로
                                     타일 안쪽 여백까지 먹어 모서리 끝까지 잡힌다. -->
                                <Border Width="36" Height="36" Margin="0,0,-6,-6"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="Transparent" Cursor="SizeNWSE"
                                        ToolTip="끌어서 크기 조절"
                                        MouseLeftButtonDown="OnGripMouseDown">
                                    <Border Width="18" Height="18" Margin="0,0,6,6"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{StaticResource Brush.EditChrome}"
                                            CornerRadius="3" IsHitTestVisible="False">
                                        <TextBlock Text="◢" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.EditChromeText}" />
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── 3층: 드래그 미리보기 — 격자에 스냅된 목표 자리 ── -->
        <Grid x:Name="PreviewLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <Border x:Name="PreviewBox" CornerRadius="4" BorderThickness="2"
                    Margin="{Binding DataContext.TileGap, ElementName=Root,
                             Converter={StaticResource TileMargin}}"
                    BorderBrush="{StaticResource Brush.Accent}"
                    Background="{StaticResource Brush.AccentSurface}">
                <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource Brush.EditChromeText}" />
            </Border>
        </Grid>

        <!-- ── 빈 칸 클릭 → 폴더 선택 (드래그와 함께 두 경로 중 하나) ──
                 Popup 안에서는 RelativeSource 로 위로 못 올라간다(별도 비주얼 트리).
                 ElementName 은 같은 이름 범위라 닿으므로 Root 를 거쳐 커맨드를 잡는다. -->
        <Popup x:Name="FolderPicker" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" PopupAnimation="Fade"
               IsOpen="{Binding IsFolderPickerOpen, Mode=TwoWay}"
               Closed="OnFolderPickerClosed">
            <Border Background="{StaticResource Brush.Surface}" CornerRadius="4"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    Padding="6" MinWidth="220">
                <StackPanel>
                    <TextBlock Text="이 칸에 넣을 것" FontWeight="SemiBold" Margin="4,2,4,6" />

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
                                    <!-- 이미 상시 칸에 있는 폴더는 고를 수 없다 —
                                         목록에서 지우지 않고 왜 못 고르는지 옆에 적는다. -->
                                    <Button Style="{StaticResource FolderRowButton}"
                                            Padding="6,4"
                                            IsEnabled="{Binding CanPlaceInGrid}"
                                            ToolTip="{Binding PathText}"
                                            Command="{Binding DataContext.PlaceFolderCommand,
                                                              ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="이미 상시 칸"
                                                       FontSize="10" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextSecondary}"
                                                       Visibility="{Binding HasPinnedTile,
                                                            Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Separator Margin="0,4" />

                    <Button Style="{StaticResource FolderRowButton}" Padding="6,4"
                            ToolTip="폴더를 못박지 않는 칸. 왼쪽 리스트에서 이 번호를 지정한 폴더가 여기에 뜬다."
                            Command="{Binding DataContext.PlaceRotatingCommand, ElementName=Root}">
                        <TextBlock Text="빈 순환 칸 만들기" FontStyle="Italic" />
                    </Button>

                    <!-- 전역 검색 타일(D69-e). 워크스페이스 전체에서 하나뿐이라 이미 있으면
                         잠근다 — 폴더 쪽("이미 상시 칸")과 같은 처리: 목록에서 지우지 않고
                         옆에 왜 못 고르는지 적는다. -->
                    <Button Style="{StaticResource FolderRowButton}" Padding="6,4" Margin="0,2,0,0"
                            IsEnabled="{Binding DataContext.HasSearchTile, ElementName=Root,
                                        Converter={StaticResource InverseBool}}"
                            ToolTip="이 워크스페이스 전체에서 파일을 찾는 칸. Everything(voidtools) 이 설치·실행 중이어야 한다."
                            Command="{Binding DataContext.PlaceSearchCommand, ElementName=Root}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="이미 있다"
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       Visibility="{Binding DataContext.HasSearchTile, ElementName=Root,
                                            Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="전역 검색" FontStyle="Italic" />
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
