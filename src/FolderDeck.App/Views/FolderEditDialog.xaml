<Window x:Class="FolderDeck.App.Views.FolderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="폴더 수정"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14">
        <TextBlock Text="경로" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBlock x:Name="PathText" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Brush.TextSecondary}" />

        <TextBlock Text="표시 이름" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Padding="5,4" />
        <TextBlock FontSize="11" Margin="0,2,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   Text="비우면 경로의 잎 이름으로 되돌아간다." />

        <TextBlock Text="설명" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DescriptionBox" Padding="5,4"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="56" VerticalScrollBarVisibility="Auto" />
        <TextBlock FontSize="11" Margin="0,2,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   Text="비어 있으면 목록에 설명 줄이 뜨지 않는다." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="저장" Padding="16,5" Margin="0,0,8,0" IsDefault="True"
                    Click="OnAccept" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
