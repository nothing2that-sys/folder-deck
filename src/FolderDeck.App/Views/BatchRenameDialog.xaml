<Window x:Class="FolderDeck.App.Views.BatchRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일괄 이름 바꾸기"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}">

    <!--
        배치 리네임(기능 후보 ③, 2026-09-18 설계, doc/FeatureCandidates_2026-09-18_design.md
        §③). 이름 변환·충돌·무효 판정은 전부 순수 함수(FolderDeck.Core.Renaming.
        BatchRenamePlanner)가 한다 — 이 창은 입력을 모아 그 함수를 부르고 결과를 보여줄
        뿐이다. RenameDialog·MacroDialog 와 같은 결로 코드 비하인드가 상태를 들고, 별도
        ViewModel 클래스를 새로 만들지 않는다.
    -->
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <RadioButton x:Name="FindReplaceRadio" Content="찾기/바꾸기" GroupName="Rule"
                         Checked="OnRuleChanged" />
            <RadioButton x:Name="NumberingRadio" Content="번호 매기기" GroupName="Rule"
                         Margin="16,0,0,0" Checked="OnRuleChanged" />
            <RadioButton x:Name="CaseRadio" Content="대소문자 변환" GroupName="Rule"
                         Margin="16,0,0,0" Checked="OnRuleChanged" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <StackPanel x:Name="FindReplacePanel" Orientation="Horizontal">
                <TextBlock Text="찾기" VerticalAlignment="Center" />
                <TextBox x:Name="FindBox" Width="150" Margin="6,0,16,0" Padding="4,2"
                         TextChanged="OnInputChanged" />
                <TextBlock Text="바꾸기" VerticalAlignment="Center" />
                <TextBox x:Name="ReplaceBox" Width="150" Margin="6,0,0,0" Padding="4,2"
                         TextChanged="OnInputChanged" />
            </StackPanel>
            <StackPanel x:Name="NumberingPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="접두어" VerticalAlignment="Center" />
                <TextBox x:Name="PrefixBox" Width="100" Margin="6,0,16,0" Padding="4,2"
                         TextChanged="OnInputChanged" />
                <TextBlock Text="시작 번호" VerticalAlignment="Center" />
                <TextBox x:Name="StartBox" Width="50" Margin="6,0,16,0" Padding="4,2" Text="1"
                         TextChanged="OnInputChanged" />
                <TextBlock Text="자릿수" VerticalAlignment="Center" />
                <TextBox x:Name="PaddingBox" Width="50" Margin="6,0,0,0" Padding="4,2" Text="3"
                         TextChanged="OnInputChanged" />
            </StackPanel>
            <StackPanel x:Name="CasePanel" Orientation="Horizontal" Visibility="Collapsed">
                <RadioButton x:Name="UpperRadio" Content="대문자" GroupName="Case"
                             Checked="OnInputChanged" />
                <RadioButton x:Name="LowerRadio" Content="소문자" GroupName="Case"
                             Margin="16,0,0,0" Checked="OnInputChanged" />
                <RadioButton x:Name="TitleRadio" Content="첫 글자만 대문자" GroupName="Case"
                             Margin="16,0,0,0" Checked="OnInputChanged" />
            </StackPanel>
        </Grid>

        <ListView x:Name="PreviewList" Grid.Row="2" Margin="0,10,0,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="지금 이름" Width="240"
                                    DisplayMemberBinding="{Binding OriginalName}" />
                    <GridViewColumn Header="바뀔 이름" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NewName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Brush.Danger}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Danger}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ExecuteButton" Content="바꾸기" Padding="16,5" Margin="0,0,8,0"
                    IsDefault="True" Click="OnExecute" />
            <Button Content="취소" Padding="16,5" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
