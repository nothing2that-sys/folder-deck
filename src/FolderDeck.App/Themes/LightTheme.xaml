<!--
    테마 브러시 — 앱의 모든 색은 여기를 거친다.

    컨트롤에 #RRGGBB 를 직접 쓰지 말 것. 새 색이 필요하면 여기에 이름을 하나 만든다.
    그 규칙이 지켜져 지금 이 파일 밖의 색 리터럴은 0건이다.

    테마 교체는 시작 시 딕셔너리를 골라 병합하는 방식이며 런타임 교체는 지원하지 않는다 —
    색 참조가 전부 StaticResource 라(DynamicResource 0건) 실행 중에 갈아끼워도 반영되지 않는다.
    근거는 doc/FolderDeck_familylook_spec.md §7.

    토큰 이름 규약은 같은 문서 §3·§4 를 따른다 — 이름을 새로 지을 때 형제 앱과 같이 정한다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── 면 ── -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#FCFCFC" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#F3F3F3" />

    <!-- ── 테두리 ── -->
    <SolidColorBrush x:Key="Brush.Border" Color="#DDDDDD" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#E5E5E5" />

    <!-- ── 글자 ── -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#767676" />

    <!-- ── 의미색: 색은 뜻 하나씩 (§3.2). 호박 = 상시, 보라 = 순환, 청록 = 검색(D69-e).
             테두리 실선/점선으로 색 없이도 구분되게 하는 원칙은 그대로 유지한다 — 검색은
             이름표 칩의 글리프(🔍)가 그 역할을 한다(색만으로 가르지 않는다). ── -->
    <SolidColorBrush x:Key="Brush.Pinned" Color="#FFB300" />
    <SolidColorBrush x:Key="Brush.Rotating" Color="#7E57C2" />
    <SolidColorBrush x:Key="Brush.Search" Color="#00897B" />

    <!-- 칩 배경 — 위 의미색의 옅은 짝.
             RotatingSurface 는 아래 RowActive 와 값이 같지만 의도된 별개 키다 — 뜻이
             둘이라(타일 면 / 행 활성) 다크에서 갈릴 수 있다. 합치지 말 것. -->
    <SolidColorBrush x:Key="Brush.PinnedSurface" Color="#FFF6E0" />
    <SolidColorBrush x:Key="Brush.RotatingSurface" Color="#EDE7F6" />
    <SolidColorBrush x:Key="Brush.SearchSurface" Color="#E0F2F1" />

    <!-- ── 파일 목록 항목의 종류 (Phase 8-C 1) ──
             폴더와 파일을 가르는 색이다. WPF 는 컬러 폰트를 그리지 않아 목록 글자 크기에서
             폴더/파일 두 글리프가 같은 굵기의 가는 윤곽선으로 떨어진다 — 형태로는 약해서
             색으로 가른다. 글리프 어휘는 familylook_spec.md 6 의 표(폴더/파일)를 그대로 쓴다.

             위 의미색(호박=상시 / 보라=순환)과 <b>축이 다르다</b>: 저것은 타일 하나의 성격이고
             이것은 타일 <b>안</b> 목록 항목의 종류다. 그래서 키를 따로 둔다. 값도 일부러
             떨어뜨렸다 — Folder 는 Pinned(#FFB300)보다 어둡고 탁한 황토라 같은 화면에서
             호박 테두리와 헷갈리지 않고, 흰 배경 위의 얇은 윤곽선으로도 읽힌다.

             File 은 <b>무채색</b>이다. 색상축에서 폴더와 가장 멀고, 목록에서 다수인 쪽이
             물러나므로 훑는 눈에 폴더가 먼저 걸린다. -->
    <SolidColorBrush x:Key="Brush.FolderGlyph" Color="#B26A00" />
    <SolidColorBrush x:Key="Brush.FileGlyph" Color="#9AA0A6" />

    <!-- ── 실패 ── -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C62828" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="#FDECEA" />

    <!-- ── 내용 비교(기능 후보 ①의 연장, 2026-09-18) — 추가/변경 표시.
         삭제는 위 DangerSurface 를 그대로 쓴다(새 키를 안 만든다). WarningSurface 는 위
         PinnedSurface(#FFF6E0)와 색이 거의 같아 보이지만 우연이다 — 둘 다 "황토색 계열
         옅은 배경"일 뿐 뜻은 다르다(하나는 타일 고정, 하나는 줄 변경), 그래서 별개 키다. -->
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#E6F4EA" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="#FFF3CD" />

    <!-- ── 상호작용 ──
             RowActive 는 위 RotatingSurface 와 값이 같지만 별개 키다(위 주석 참고). -->
    <SolidColorBrush x:Key="Brush.RowHover" Color="#EAF1FB" />
    <SolidColorBrush x:Key="Brush.RowActive" Color="#EDE7F6" />

    <!-- 파일 목록에서 고른 항목 (§4.2-1 · Phase 5 Stage 3C).
         RowActive("행 활성·선택")와 뜻이 겹쳐 보이지만 그것은 왼쪽 폴더 리스트 행의 값이고
         이 앱에서 값이 다르므로 별개 키다.

         값은 WPF 기본 활성 선택색 그대로다(실측 #FFCCEFFE). 포커스가 있든 없든 이 하나를 쓴다 —
         타일 여럿이 동시에 보이는 덱이라 포커스 없는 목록의 선택도 보여야 한다. 기본 템플릿은
         Selector.IsSelectionActive 로 갈라 포커스가 없으면 #ECECEC 로 그려 흰 배경에 묻혔다.

         AccentSurface(고무줄 사각형 면 · 드롭 과녁)와 <b>일부러 다른 색이다</b> — 끌고 있는 중에
         이미 골라진 행과 사각형이 구분돼야 한다. -->
    <SolidColorBrush x:Key="Brush.SelectionSurface" Color="#FFCCEFFE" />

    <!-- 키보드 포커스가 든 타일의 활성 링 (Phase 5 「타일 포커스」 C-2).
         "지금 키가 이 타일로 간다"를 말한다 — 선택(SelectionSurface)과 층이 다르다:
         저것은 타일 안 항목 단위고 이것은 타일 단위다.

         Accent 를 쓰지 않는다: 드롭 과녁·고무줄이 그 색이고 "여기에 놓인다"와 "여기에 키가
         간다"는 다른 뜻이다 — 끌고 있는 동안 둘이 같은 파랑이면 갈리지 않는다.
         RowActive 를 쓰지 않는다: 그 키는 왼쪽 폴더 리스트 행의 자리다(familylook_spec.md
         §4.3). 값이 같아도 뜻이 둘이면 키를 둘 유지한다는 것이 그 문서의 규칙이다(§4.3).

         상시(호박 실선)·순환(보라 점선) 테두리와 같은 자리에 겹쳐 뜨므로 무채색 계열로 잡아
         성격 표시를 흐리지 않게 한다. <b>이 값은 고른 값이고 실측이 아니다.</b> -->
    <SolidColorBrush x:Key="Brush.TileActive" Color="#37474F" />

    <!-- ── 배치 편집 모드 (Phase 2) ──
             편집 중임이 한눈에 보여야 한다: 격자 경계가 드러나고 타일 위에 손잡이 층이 덮인다.
             파랑 = "지금 놓을 수 있는 자리", 빨강(Danger) = "겹쳐서 못 놓음". -->
    <SolidColorBrush x:Key="Brush.GridLine" Color="#C4C4C4" />
    <SolidColorBrush x:Key="Brush.GridCellSurface" Color="#F0F0F0" />

    <!-- 타일을 덮는 반투명 손잡이 층 — 아래 파일 목록이 비쳐 보이되 잠긴 느낌이 나야 한다. -->
    <SolidColorBrush x:Key="Brush.EditOverlay" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="Brush.EditChrome" Color="#DCE7F5" />
    <SolidColorBrush x:Key="Brush.EditChromeText" Color="#274264" />

    <!-- ── 강조 ──
             Accent 는 드롭 과녁·활성·진행에 두루 쓰인다(진행 막대 Foreground 포함). 뜻이
             "드롭 과녁" 하나보다 넓어 이름을 뜻에 맞췄다. 형제 앱과 같은 이름 같은 뜻이며
             다크 짝은 #58a6ff 다 — doc/FolderDeck_familylook_spec.md §4.1. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#3D8BE0" />
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="#66BBD9F5" />

    <!-- 배치 편집 중 겹쳐서 못 놓는 자리의 미리보기 면 (TileGridView.xaml.cs 의 FindResource).
             파일 드롭 과녁은 §4.2 대로 받지 않는 자리를 아예 켜지 않으므로 여기에만 쓰인다. -->
    <SolidColorBrush x:Key="Brush.DropInvalidSurface" Color="#55E9A8A8" />

</ResourceDictionary>
