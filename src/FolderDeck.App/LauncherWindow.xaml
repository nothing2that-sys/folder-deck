<Window x:Class="FolderDeck.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LauncherViewModel}"
        Title="FolderDeck — 작업 관리 열기"
        Height="680" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <DockPanel Margin="14">

        <!-- ── 머리 + 필터 ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="작업 관리" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="한 프로젝트에 속한 폴더들을 묶어 한 화면에 펼친다. 폴더에 등록만 하며, 실제 파일은 건드리지 않는다." />

            <!-- 제목·경로로 좁히는 한 줄 필터. 카드가 여럿일 때만 나온다. -->
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,10,0,0" Padding="6,4" VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource Brush.Border}"
                     ToolTip="제목이나 경로로 좁히기 (대소문자 무시 · 부분일치)"
                     AutomationProperties.Name="작업 관리 필터"
                     Visibility="{Binding ShowFilter, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ── 발: 자동 열기 토글 + 메시지 ── -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            <CheckBox IsChecked="{Binding SkipLauncher}"
                      IsEnabled="{Binding CanChangeSkipLauncher}"
                      Content="마지막 작업을 자동으로 열기 (이 화면 건너뛰기)"
                      ToolTip="켜면 다음 실행부터 곧바로 마지막 작업 관리가 열린다. 여기서 다시 끌 수 있다." />
        </StackPanel>

        <!-- ── 새로 만들기 (인라인 폼) ── -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12" CornerRadius="4"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="새 작업 관리" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="제목" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3" Margin="0,2,0,8" />

                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="폴더 추가…" Padding="10,3"
                            Command="{Binding AddFoldersFromPickerCommand}" />
                    <TextBlock Text="폴더 (최소 1개 · 창에 끌어다 놓아도 된다)" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                </DockPanel>

                <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                        MinHeight="60" MaxHeight="150" CornerRadius="3" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                                Style="{StaticResource LinkButton}"
                                                ToolTip="목록에서 빼기"
                                                Command="{Binding DataContext.RemoveNewFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Consolas" ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="취소" Padding="14,4" Margin="0,0,6,0"
                            Command="{Binding CancelCreateCommand}" />
                    <Button Content="만들기" Padding="14,4" Command="{Binding CreateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 카드 목록: workspaces\*.json 열거 결과 (§3.1) ── -->
        <Grid>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="저장된 작업 관리가 없다.&#x0a;아래 점선 타일로 첫 묶음을 만들면 된다."
                       Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="필터에 걸리는 작업 관리가 없다."
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspaceCardViewModel}">
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="4"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCorrupt}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Brush.Danger}" />
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.DangerSurface}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ══ 왼쪽: 정체성 블록 ══ -->
                                        <StackPanel Grid.Column="0"
                                                    Visibility="{Binding IsUsable,
                                                        Converter={StaticResource BoolToVisibility}}">

                                            <!-- 제목 + "열려 있음" 배지 (§4.1 — 색만으로 구분하지 않으므로 글자가 있다) -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding IsEditing,
                                                               Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Border Style="{StaticResource ChipBorder}" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource Brush.RotatingSurface}"
                                                        BorderBrush="{StaticResource Brush.Rotating}"
                                                        Visibility="{Binding IsOpen,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="열려 있음" FontSize="10"
                                                               Foreground="{StaticResource Brush.Rotating}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 편집 모드: 제목·설명 인라인 수정 -->
                                            <StackPanel Visibility="{Binding IsEditing,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                         FontSize="15" FontWeight="SemiBold" Padding="3,2"
                                                         BorderBrush="{StaticResource Brush.Border}"
                                                         AutomationProperties.Name="제목 수정" />
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,4,0,0" Padding="3,2" TextWrapping="Wrap"
                                                         BorderBrush="{StaticResource Brush.Border}"
                                                         AutomationProperties.Name="설명 수정" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- 경로는 1급 요소 — 개발자는 경로로 워크스페이스를 알아본다. -->
                                            <TextBlock Text="{Binding PrimaryPath}" FontFamily="Consolas"
                                                       FontSize="11" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PrimaryPath}"
                                                       Foreground="{StaticResource Brush.TextPrimary}" />

                                            <!-- 폴더 구성 스트립: 상시 칩 + "+ 순환 N" -->
                                            <ItemsControl ItemsSource="{Binding PinnedChips}" Margin="0,7,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ChipBorder}" Margin="0,0,4,4"
                                                                Background="{StaticResource Brush.PinnedSurface}"
                                                                BorderBrush="{StaticResource Brush.Pinned}"
                                                                ToolTip="상시 표시 폴더">
                                                            <TextBlock Text="{Binding}" FontSize="11" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <Border Style="{StaticResource ChipBorder}"
                                                        Background="{StaticResource Brush.PinnedSurface}"
                                                        BorderBrush="{StaticResource Brush.Pinned}"
                                                        Visibility="{Binding HasMorePinned,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding MorePinnedText}" FontSize="11" />
                                                </Border>

                                                <!-- 순환 칩은 점선 테두리 — 메인 창의 순환 칸과 같은 감각 -->
                                                <Border Style="{StaticResource ChipBorder}"
                                                        Background="{StaticResource Brush.RotatingSurface}"
                                                        BorderBrush="{StaticResource Brush.Rotating}"
                                                        ToolTip="상시로 지정되지 않은 폴더 — 순환 칸에서 번갈아 본다"
                                                        Visibility="{Binding HasRotatingChip,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding RotatingChipText}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Rotating}" />
                                                </Border>

                                                <TextBlock Text="등록된 폴더 없음" FontSize="11"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           Visibility="{Binding HasNoFolders,
                                                               Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding MetaText}" FontSize="11" Margin="0,4,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                        </StackPanel>

                                        <!-- ══ 읽지 못한 파일 — 열기/수정 없음 (§5) ══ -->
                                        <StackPanel Grid.Column="0"
                                                    Visibility="{Binding IsCorrupt,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CorruptText}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CorruptDetail}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding PathText}" TextWrapping="Wrap"
                                                       FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                        </StackPanel>

                                        <!-- ══ 오른쪽: 액션 ══ -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Visibility="{Binding IsUsable,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <!-- 글씨가 곧 동작이다 (§4.1): 떠 있으면 "창 보이기", 아니면 "열기". -->
                                            <Button Content="{Binding OpenButtonText}" Padding="20,5" FontWeight="SemiBold"
                                                    AutomationProperties.Name="{Binding OpenButtonText}"
                                                    Command="{Binding DataContext.OpenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="ToolTip" Value="새 창으로 이 작업 관리를 연다." />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="ToolTip"
                                                                        Value="이미 떠 있는 창을 앞으로 가져온다 (닫혀 있었으면 새로 연다)." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Padding="20,3" Margin="0,6,0,0"
                                                    Command="{Binding DataContext.ToggleEditCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="수정" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Content" Value="완료" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="삭제" Padding="20,3" Margin="0,6,0,0"
                                                    ToolTip="작업 관리만 삭제 — 실제 폴더는 그대로"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Visibility="{Binding IsCorrupt,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="파일 위치 보기" Padding="14,5"
                                                    Command="{Binding DataContext.RevealFileCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 목록 끝의 점선 타일 = 새로 만들기 -->
                    <Button Command="{Binding StartCreateCommand}" Cursor="Hand"
                            HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                            AutomationProperties.Name="새 작업 관리 만들기">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Rectangle RadiusX="4" RadiusY="4" StrokeThickness="1"
                                                           StrokeDashArray="4 3"
                                                           Stroke="{StaticResource Brush.Border}"
                                                           Fill="Transparent" />
                                                <ContentPresenter Margin="12,14" HorizontalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="＋ 새 작업 관리 만들기"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
