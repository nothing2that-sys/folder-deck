<Window x:Class="FolderDeck.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FolderDeck.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LauncherViewModel}"
        Title="FolderDeck — 작업 관리 열기"
        Height="680" Width="880"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Chrome}"
        FontFamily="Segoe UI" FontSize="12"
        Foreground="{StaticResource Brush.TextPrimary}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver">

    <!--
        MinWidth/MinHeight 의 하한은 카드 하나가 온전히 보이는 크기다: 창 여백 28 +
        카드 테두리 2 + 패딩 24 + 버튼열 ≈ 94 + 버튼 여백 12 + 스크롤바 ≈ 17 = 177 이 고정이고,
        제목·설명·경로가 읽히려면 왼쪽에 300 은 있어야 한다. 520 은 거기에 여유를 둔 값이다.
        높이 420 = 머리(제목·설명·필터) ≈ 100 + 카드 하나 + 새로 만들기 폼 ≈ 52 +
        발(＋ 새 작업 공간 버튼 · 자동 열기 토글 한 줄) ≈ 32 + 창 여백 28 + 창 크롬 31 에 여유.
        카드 하나는 Phase 8-A ⑥ 로 세 줄이 되어 전보다 낮아졌다 — 하한이 더 넉넉해졌다.
        런처는 창 위치를 저장하지 않으므로(§6.1) 값을 여기 직접 둔다 — 클램프하는 코드가 없다.
    -->
    <DockPanel Margin="14">

        <!-- ── 머리 + 필터 ── -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="작업 관리" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="한 프로젝트에 속한 폴더들을 묶어 한 화면에 펼친다. 폴더에 등록만 하며, 실제 파일은 건드리지 않는다." />

            <!-- 제목·경로로 좁히는 한 줄 필터. 카드가 여럿일 때만 나온다. -->
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,10,0,0" Padding="6,4" VerticalContentAlignment="Center"
                     BorderBrush="{StaticResource Brush.Border}"
                     ToolTip="제목이나 경로로 좁히기 (대소문자 무시 · 부분일치)"
                     AutomationProperties.Name="작업 관리 필터"
                     Visibility="{Binding ShowFilter, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ── 발: 하단 고정 바 (Phase 8-A ①②) ──
                 만들기와 자동 열기 토글은 목록이 아무리 길어도 늘 같은 자리에 있어야 하므로
                 스크롤 영역 밖 여기에 둔다. 버튼이 맨 왼쪽, 토글이 그 오른쪽이다. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Danger}"
                       TextWrapping="Wrap" Margin="0,0,0,6"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="＋ 새 작업 공간" Padding="14,5"
                        Margin="0,0,12,0" FontWeight="SemiBold"
                        Command="{Binding StartCreateCommand}"
                        AutomationProperties.Name="새 작업 공간 만들기"
                        ToolTip="새 작업 공간을 만든다 — 목록과 이 줄 사이에 폼이 열린다."
                        Visibility="{Binding IsCreating,
                                     Converter={StaticResource InverseBoolToVisibility}}" />
                <CheckBox IsChecked="{Binding SkipLauncher}"
                          IsEnabled="{Binding CanChangeSkipLauncher}"
                          VerticalAlignment="Center"
                          Content="마지막 작업을 자동으로 열기 (이 화면 건너뛰기)"
                          ToolTip="켜면 다음 실행부터 곧바로 마지막 작업 관리가 열린다. 여기서 다시 끌 수 있다." />
            </DockPanel>
        </StackPanel>

        <!-- ── 새로 만들기 (인라인 폼) ── -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12" CornerRadius="4"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                Visibility="{Binding IsCreating, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="새 작업 관리" FontWeight="SemiBold" Margin="0,0,0,8" />

                <TextBlock Text="제목" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" />
                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3" Margin="0,2,0,8" />

                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="폴더 추가…" Padding="10,3"
                            Command="{Binding AddFoldersFromPickerCommand}" />
                    <TextBlock Text="폴더 (최소 1개 · 창에 끌어다 놓아도 된다)" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" />
                </DockPanel>

                <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1"
                        MinHeight="60" MaxHeight="150" CornerRadius="3" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <Button DockPanel.Dock="Right" Content="✕" Padding="6,0"
                                                Style="{StaticResource LinkButton}"
                                                ToolTip="목록에서 빼기"
                                                Command="{Binding DataContext.RemoveNewFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Consolas" ToolTip="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="취소" Padding="14,4" Margin="0,0,6,0"
                            Command="{Binding CancelCreateCommand}" />
                    <Button Content="만들기" Padding="14,4" Command="{Binding CreateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 카드 목록: workspaces\*.json 열거 결과 (§3.1) ── -->
        <Grid>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="저장된 작업 관리가 없다.&#x0a;아래 &#x0027;＋ 새 작업 공간&#x0027; 으로 첫 묶음을 만들면 된다."
                       Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Text="필터에 걸리는 작업 관리가 없다."
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspaceCardViewModel}">
                                <!-- 한 번 = 선택, 두 번 = 열기 (Phase 8-A ④). 안쪽 버튼·입력칸은
                                     자기 클릭을 스스로 처리하므로 여기까지 올라오지 않는다 —
                                     "열기"를 누르는 것이 곧 선택이 되어 버리지 않는다. -->
                                <Border Margin="0,0,0,6" Padding="10" CornerRadius="4"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="OnCardMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                            <Style.Triggers>
                                                <!-- 고른 카드. 색만으로 구분하지 않는 결(§3.2)은 여기서
                                                     테두리 두께가 함께 바뀌는 것으로 지킨다. -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Brush.Accent}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                    <Setter Property="Padding" Value="9" />
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.AccentSurface}" />
                                                </DataTrigger>

                                                <!-- 손상은 선택보다 세다 — 뒤에 두어 이긴다. -->
                                                <DataTrigger Binding="{Binding IsCorrupt}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource Brush.Danger}" />
                                                    <Setter Property="Background"
                                                            Value="{StaticResource Brush.DangerSurface}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ══ 왼쪽: 정체성 블록 ══ -->
                                        <StackPanel Grid.Column="0"
                                                    Visibility="{Binding IsUsable,
                                                        Converter={StaticResource BoolToVisibility}}">

                                            <!-- ⑥ 1줄: 제목 + 설명 (+ "열려 있음" 배지).
                                                 §4.1 — 색만으로 구분하지 않으므로 배지에 글자가 있다.
                                                 제목 칸은 Auto 이되 상한을 둔다: 상한이 없으면 긴 제목이
                                                 줄을 다 먹어 설명이 한 글자도 안 남는다. 240 은 창
                                                 MinWidth(520)에서 왼쪽에 남는 ~300 을 기준으로 잡은 값이다. -->
                                            <Grid Visibility="{Binding IsEditing,
                                                      Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MaxWidth="240" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Title}" />

                                                <Border Grid.Column="1" Style="{StaticResource ChipBorder}"
                                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{StaticResource Brush.RotatingSurface}"
                                                        BorderBrush="{StaticResource Brush.Rotating}"
                                                        Visibility="{Binding IsOpen,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="열려 있음" FontSize="10"
                                                               Foreground="{StaticResource Brush.Rotating}" />
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Description}"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           Visibility="{Binding HasDescription,
                                                               Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>

                                            <!-- 편집 모드: 제목·설명 인라인 수정 -->
                                            <StackPanel Visibility="{Binding IsEditing,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                         FontSize="15" FontWeight="SemiBold" Padding="3,2"
                                                         BorderBrush="{StaticResource Brush.Border}"
                                                         AutomationProperties.Name="제목 수정" />
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,4,0,0" Padding="3,2" TextWrapping="Wrap"
                                                         BorderBrush="{StaticResource Brush.Border}"
                                                         AutomationProperties.Name="설명 수정" />
                                            </StackPanel>

                                            <!-- ⑥ 2줄: 마지막 사용 시각 · 대표 폴더 경로.
                                                 경로가 오른쪽에서 남는 폭을 다 먹고 줄어들 때 먼저 잘린다 —
                                                 왼쪽 조각은 짧고 길이가 거의 변하지 않기 때문이다.
                                                 폴더 개수는 Phase 8-B 4 에서 3줄 맨 앞으로 내려갔다 —
                                                 뒤에 오는 이름들이 무엇의 목록인지 거기서 말해야 한다. -->
                                            <DockPanel Margin="0,4,0,0"
                                                       Visibility="{Binding IsEditing,
                                                           Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding LastUsedText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Brush.TextSecondary}" />

                                                <!-- 경로는 1급 요소 — 개발자는 경로로 워크스페이스를 알아본다. -->
                                                <TextBlock Text="{Binding PrimaryPath}" FontFamily="Consolas"
                                                           FontSize="11" Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding PrimaryPath}"
                                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                            </DockPanel>

                                            <!-- 3줄: 폴더 개수 · 상시 이름 · 순환 이름 (Phase 8-B 4).

                                                 순환도 이름으로 적는다. 그 전에는 "+ 순환 3" 이라는 개수
                                                 칩이었는데, 개수만으로는 어느 워크스페이스인지 알아볼 수가
                                                 없었다 — 상시가 하나도 없는 워크스페이스는 3줄이 통째로
                                                 숫자 하나였다.

                                                 <b>TextBlock 하나에 Run 셋</b>이다. 칩을 늘어놓거나
                                                 TextBlock 을 나란히 두면 줄바꿈해 카드가 높아지고(⑥ 이
                                                 없애려던 것이다) 줄 전체를 한 번에 자를 수도 없다.
                                                 Run 은 한 흐름 안에 있어 색만 갈리고 잘림은 줄 단위다.

                                                 색이 상시/순환을 갈라 주지만 <b>색만으로 나르지 않는다</b>
                                                 (§3.2): 상시가 앞·순환이 뒤라는 순서가 같은 말을 하고,
                                                 잘렸을 때는 툴팁이 줄 전체를 돌려준다.
                                                 구분점은 Run 쪽이 달고 온다 — 여기 두면 앞 조각이 비었을 때
                                                 점만 뜬다(폴더가 전부 상시이거나 전부 순환인 워크스페이스). -->
                                            <DockPanel Margin="0,4,0,0"
                                                       Visibility="{Binding IsEditing,
                                                           Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Left" Text="등록된 폴더 없음" FontSize="11"
                                                           Foreground="{StaticResource Brush.TextSecondary}"
                                                           Visibility="{Binding HasNoFolders,
                                                               Converter={StaticResource BoolToVisibility}}" />

                                                <!-- Run 사이에 줄바꿈을 두지 않는다: TextBlock 안에서
                                                     요소 사이의 공백은 공백 한 칸으로 살아남아
                                                     "폴더 6  · 이름" 처럼 점 앞이 벌어진다.
                                                     그래서 /><Run 이 붙어 있다 — 보기는 나쁘지만
                                                     구분점을 문자열이 들고 오는 이유가 이것이다. -->
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FolderNamesText}"
                                                           Visibility="{Binding HasNoFolders,
                                                               Converter={StaticResource InverseBoolToVisibility}}"><Run
                                                         Text="{Binding FolderCountText, Mode=OneWay}"
                                                         Foreground="{StaticResource Brush.TextSecondary}" /><Run
                                                         Text="{Binding PinnedNamesRun, Mode=OneWay}"
                                                         Foreground="{StaticResource Brush.Pinned}" /><Run
                                                         Text="{Binding RotatingNamesRun, Mode=OneWay}"
                                                         Foreground="{StaticResource Brush.Rotating}" /></TextBlock>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- ══ 읽지 못한 파일 — 열기/수정 없음 (§5) ══ -->
                                        <StackPanel Grid.Column="0"
                                                    Visibility="{Binding IsCorrupt,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CorruptText}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CorruptDetail}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding PathText}" TextWrapping="Wrap"
                                                       FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                        </StackPanel>

                                        <!-- ══ 오른쪽: 액션 ══ -->
                                        <!-- ⑤ 세로 → 가로. 세로로 쌓으면 버튼 셋의 높이가 카드 높이의
                                             하한이 되어 ⑥ 으로 줄인 본문이 도로 벌어진다. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Visibility="{Binding IsUsable,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <!-- 글씨가 곧 동작이다 (§3.1): 떠 있으면 "열려 있음", 아니면 "열기". -->
                                            <Button Content="{Binding OpenButtonText}" Padding="16,4" FontWeight="SemiBold"
                                                    AutomationProperties.Name="{Binding OpenButtonText}"
                                                    Command="{Binding DataContext.OpenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="ToolTip" Value="이 작업 관리를 연다. 이 창이 그 창이 된다." />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                                <Setter Property="ToolTip"
                                                                        Value="이미 열려 있다. 눌러도 아무 일도 일어나지 않는다." />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Padding="16,4" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ToggleEditCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="수정" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Content" Value="완료" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="삭제" Padding="16,4" Margin="6,0,0,0"
                                                    ToolTip="작업 관리만 삭제 — 실제 폴더는 그대로"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                    Visibility="{Binding IsCorrupt,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="파일 위치 보기" Padding="14,5"
                                                    Command="{Binding DataContext.RevealFileCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
